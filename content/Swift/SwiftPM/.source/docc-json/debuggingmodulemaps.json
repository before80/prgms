{"abstract":[{"text":"Diagnose and resolve issues when Swift can’t import your C or C++ libraries.","type":"text"}],"hierarchy":{"paths":[["doc://PackageManagerDocs/documentation/PackageManagerDocs","doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMaps"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://PackageManagerDocs/documentation/PackageManagerDocs/DebuggingModuleMaps"},"kind":"article","metadata":{"modules":[{"name":"Swift Package Manager"}],"role":"article","roleHeading":"Article","title":"Debugging Module Maps"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"When you create module maps for C libraries, compilation errors or import failures indicate problems with your configuration.","type":"text"},{"text":" ","type":"text"},{"text":"This article shows you how to test module maps and fix common issues.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use these techniques when:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Swift can’t find your module","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Headers fail to import","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"C++ code produces compilation errors","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"You need to verify Swift Package Manager configures your module correctly","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Test-your-module-map","level":2,"text":"Test your module map","type":"heading"},{"inlineContent":[{"text":"Verify that Swift can import your module before distributing it.","type":"text"}],"type":"paragraph"},{"anchor":"Create-a-simple-import-test","level":3,"text":"Create a simple import test","type":"heading"},{"inlineContent":[{"text":"Create a test Swift file that imports your module:","type":"text"}],"type":"paragraph"},{"code":["// test.swift","import MyLibrary","","print(\"Module imported successfully\")"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Build the test file:","type":"text"}],"type":"paragraph"},{"code":["swiftc -I path/to/module/directory test.swift"],"syntax":"bash","type":"codeListing"},{"inlineContent":[{"text":"If the module map has errors, the compiler produces diagnostic messages that indicates what’s wrong.","type":"text"}],"type":"paragraph"},{"anchor":"Verify-build-configuration","level":3,"text":"Verify build configuration","type":"heading"},{"inlineContent":[{"text":"Use verbose output to verify Swift Package Manager configures your module correctly:","type":"text"}],"type":"paragraph"},{"code":["swift build --verbose"],"syntax":"bash","type":"codeListing"},{"inlineContent":[{"text":"Look for these compiler flags in the output:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"-I","type":"codeVoice"},{"text":" flags pointing to your header directories","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"-fmodule-map-file=","type":"codeVoice"},{"text":" flags pointing to your module map","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Link flags for binary libraries","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Resolve-common-issues","level":2,"text":"Resolve common issues","type":"heading"},{"inlineContent":[{"text":"When Swift can’t find your module or headers, check these common causes.","type":"text"}],"type":"paragraph"},{"anchor":"Fix-module-name-mismatches","level":3,"text":"Fix module name mismatches","type":"heading"},{"inlineContent":[{"text":"Verify the module name in the module map matches the artifact or target name.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If Swift can’t find your module, verify:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The module name in the module map matches the artifact or target name exactly.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The module map file is named ","type":"text"},{"code":"module.modulemap","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"moduleMapPath","type":"codeVoice"},{"text":" in info.json points to the correct file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For system libraries, the target directory contains the module map.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Locate-missing-headers","level":3,"text":"Locate missing headers","type":"heading"},{"inlineContent":[{"text":"Verify header paths and file locations when the compiler reports missing headers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If the compiler reports a missing header:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Check that the header path in the module map is relative to the module map file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Verify the header file exists at the specified location.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Ensure the ","type":"text"},{"code":"headerPaths","type":"codeVoice"},{"text":" array in info.json includes the directory.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Fix-C++-compilation-errors","level":3,"text":"Fix C++ compilation errors","type":"heading"},{"inlineContent":[{"text":"Add C++ language support directives to resolve C++ syntax errors.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"If you get errors about C++ syntax:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Add ","type":"text"},{"code":"requires cplusplus","type":"codeVoice"},{"text":" to your module map.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For C++11 or later features, use ","type":"text"},{"code":"requires cplusplus11","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Verify your headers use appropriate ","type":"text"},{"code":"#ifdef __cplusplus","type":"codeVoice"},{"text":" guards for mixed C/C++ code.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"generated":true,"identifiers":["doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMapReference"]}],"references":{"doc://PackageManagerDocs/documentation/PackageManagerDocs":{"abstract":[{"text":"Organize, manage, and edit Swift packages.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs","kind":"symbol","navigatorTitle":[{"kind":"text","text":"Swift Package Manager"}],"role":"collection","title":"Swift Package Manager","type":"topic","url":"/documentation/packagemanagerdocs"},"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMapReference":{"abstract":[{"text":"A reference of module map directives, attributes, and syntax for defining C and C++ module interfaces.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMapReference","kind":"article","role":"article","title":"Module Map Syntax Reference","type":"topic","url":"/documentation/packagemanagerdocs/modulemapreference"},"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMaps":{"abstract":[{"text":"Define how C and C++ headers are exposed to Swift for system library targets, precompiled libraries, or C Language targets.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMaps","kind":"article","role":"collectionGroup","title":"Creating Module Maps","type":