{"abstract":[{"text":"Include C language code as a target in your Swift package.","type":"text"}],"hierarchy":{"paths":[["doc://PackageManagerDocs/documentation/PackageManagerDocs"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://PackageManagerDocs/documentation/PackageManagerDocs/CreatingCLanguageTargets"},"kind":"article","metadata":{"modules":[{"name":"Swift Package Manager"}],"role":"article","roleHeading":"Article","title":"Creating C language targets"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"C language targets are structured similarly to Swift targets, with the additional of a directory, commonly named ","type":"text"},{"code":"include","type":"codeVoice"},{"text":", to hold public header files.","type":"text"},{"text":" ","type":"text"},{"text":"If you use a directory other than ","type":"text"},{"code":"include","type":"codeVoice"},{"text":" for public headers, declare it using the ","type":"text"},{"identifier":"https://developer.apple.com/documentation/packagedescription/target/publicheaderspath","isActive":true,"type":"reference"},{"text":" on ","type":"text"},{"identifier":"https://developer.apple.com/documentation/packagedescription/target","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Swift Package manager allows only one valid C language main file for executable targets.","type":"text"},{"text":" ","type":"text"},{"text":"For example, it is invalid to have ","type":"text"},{"code":"main.c","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"main.cpp","type":"codeVoice"},{"text":" in the same target.","type":"text"}],"type":"paragraph"},{"anchor":"Exposing-C-functions-to-Swift","level":3,"text":"Exposing C functions to Swift","type":"heading"},{"inlineContent":[{"text":"Swift Package Manager automatically generates a module map for each C language library target for these use cases:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"include/Foo/Foo.h","type":"codeVoice"},{"text":" exists, ","type":"text"},{"code":"Foo","type":"codeVoice"},{"text":" is the only directory under the include directory, and the include directory contains no header files, then Swift package manager uses ","type":"text"},{"code":"include/Foo/Foo.h","type":"codeVoice"},{"text":" as the umbrella header.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"If ","type":"text"},{"code":"include/Foo.h","type":"codeVoice"},{"text":" exists and ","type":"text"},{"code":"include","type":"codeVoice"},{"text":" contains no other subdirectory, then Swift package manager uses ","type":"text"},{"code":"include/Foo.h","type":"codeVoice"},{"text":" as the umbrella header for the module map.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Otherwise, Swift package manager uses the ","type":"text"},{"code":"include","type":"codeVoice"},{"text":" directory as an umbrella directory; all headers under it are included in the module.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"In case of complicated ","type":"text"},{"code":"include","type":"codeVoice"},{"text":" layouts or headers that are not compatible with modules, provide a ","type":"text"},{"code":"module.modulemap","type":"codeVoice"},{"text":" in the ","type":"text"},{"code":"include","type":"codeVoice"},{"text":" directory.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Targets","generated":true,"identifiers":["doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMaps","doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleAliasing"],"title":"Targets"}],"references":{"doc://PackageManagerDocs/documentation/PackageManagerDocs":{"abstract":[{"text":"Organize, manage, and edit Swift packages.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs","kind":"symbol","navigatorTitle":[{"kind":"text","text":"Swift Package Manager"}],"role":"collection","title":"Swift Package Manager","type":"topic","url":"/documentation/packagemanagerdocs"},"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleAliasing":{"abstract":[{"text":"Create aliased names for modules to avoid collisions between targets in your package or its dependencies.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleAliasing","kind":"article","role":"article","title":"Module Aliasing","type":"topic","url":"/documentation/packagemanagerdocs/modulealiasing"},"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMaps":{"abstract":[{"text":"Define how C and C++ headers are exposed to Swift for system library targets, precompiled libraries, or C Language targets.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMaps","kind":"article","role":"collectionGroup","title":"Creating Module Maps","type":"topic","url":"/documentation/packagemanagerdocs/modulemaps"},"https://developer.apple.com/documentation/packagedescription/target":{"identifier":"https://developer.apple.com/documentation/packagedescription/target","title":"target","titleInlineContent":[{"text":"target","type":"text"}],"type":"link","url":"https://developer.apple.com/documentation/packagedescription/target"},"https://developer.apple.com/documentation/packagedescription/target/publicheaderspath":{"identifier":"https://developer.apple.com/documentation/packagedescription/target/publicheaderspath","title":"publicHeadersPath parameter","titleInlineContent":[{"text":"publicHeadersPath parameter","type":"text"}],"type":"link","url":"https://developer.apple.com/documentation/packagedescription/target/publicheaderspath"}}}