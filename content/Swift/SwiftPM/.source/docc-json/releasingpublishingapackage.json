{"abstract":[{"text":"Share a specific version of your package.","type":"text"}],"hierarchy":{"paths":[["doc://PackageManagerDocs/documentation/PackageManagerDocs"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://PackageManagerDocs/documentation/PackageManagerDocs/ReleasingPublishingAPackage"},"kind":"article","metadata":{"modules":[{"name":"Swift Package Manager"}],"role":"article","roleHeading":"Article","title":"Releasing and publishing a Swift package"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Swift Package Manager expects a package to be remotely shared as a single Git repository, with a tag that conforms to a full semantic version, and a ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":" manifest in the root of the repository.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To publish a package that is hosted in a Git repository, create and push a semantic version tag.","type":"text"},{"text":" ","type":"text"},{"text":"Swift package manager expects the tag to be a full semantic version, that includes major, minor, and patch versions in the tag.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following commands illustrate adding a tag ","type":"text"},{"code":"1.0.0","type":"codeVoice"},{"text":" and pushing those tags to the remote repository:","type":"text"}],"type":"paragraph"},{"code":["$ git tag 1.0.0","$ git push origin --tags"],"syntax":"bash","type":"codeListing"},{"content":[{"inlineContent":[{"text":"A tag in the form of ","type":"text"},{"code":"1.0","type":"codeVoice"},{"text":" isn’t recognized by Swift Package Manager as a complete semantic version.","type":"text"},{"text":" ","type":"text"},{"text":"Include all three integers reflecting the major, minor, and patch version information.","type":"text"}],"type":"paragraph"}],"name":"Warning","style":"warning","type":"aside"},{"inlineContent":[{"text":"With the tag in place, other packages can depend on the package you tagged through your source repository.","type":"text"},{"text":" ","type":"text"},{"text":"An example of a published package can be found at ","type":"text"},{"identifier":"https://github.com/apple/example-package-playingcard/","isActive":true,"type":"reference"},{"text":" with multiple releases available.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To read more about adding a dependency to your package, read ","type":"text"},{"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/AddingDependencies","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Building-Packages","generated":true,"identifiers":["doc://PackageManagerDocs/documentation/PackageManagerDocs/CreatingSwiftPackage","doc://PackageManagerDocs/documentation/PackageManagerDocs/SettingSwiftToolsVersion","doc://PackageManagerDocs/documentation/PackageManagerDocs/UsingBuildConfigurations","doc://PackageManagerDocs/documentation/PackageManagerDocs/SwiftVersionSpecificPackaging","doc://PackageManagerDocs/documentation/PackageManagerDocs/BundlingResources","doc://PackageManagerDocs/documentation/PackageManagerDocs/GeneratingSBOMs","doc://PackageManagerDocs/documentation/PackageManagerDocs/ContinuousIntegration","doc://PackageManagerDocs/documentation/PackageManagerDocs/UsingShellCompletion"],"title":"Building Packages"}],"references":{"doc://PackageManagerDocs/documentation/PackageManagerDocs":{"abstract":[{"text":"Organize, manage, and edit Swift packages.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs","kind":"symbol","navigatorTitle":[{"kind":"text","text":"Swift Package Manager"}],"role":"collection","title":"Swift Package Manager","type":"topic","url":"/documentation/packagemanagerdocs"},"doc://PackageManagerDocs