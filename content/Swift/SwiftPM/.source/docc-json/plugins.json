{"abstract":[{"text":"Extend package manager functionality with build or command plugins.","type":"text"}],"hierarchy":{"paths":[["doc://PackageManagerDocs/documentation/PackageManagerDocs"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://PackageManagerDocs/documentation/PackageManagerDocs/Plugins"},"kind":"article","metadata":{"modules":[{"name":"Swift Package Manager"}],"platforms":[{"beta":false,"introducedAt":"5.6","name":"Swift"}],"role":"collectionGroup","title":"Plugins"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Some of Swift Package Manager’s functionality can be extended through ","type":"text"},{"inlineContent":[{"text":"plugins","type":"text"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Write package plugins using the ","type":"text"},{"code":"PackagePlugin","type":"codeVoice"},{"text":" API provided by the Swift Package Manager. ","type":"text"},{"text":" ","type":"text"},{"text":"This is similar to how the package manifest is implemented — as Swift code that runs as needed in order to produce the information package manager needs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Package manager defines two extension points for plugins:","type":"text"}],"type":"paragraph"},{"items":[{"definition":{"content":[{"inlineContent":[{"text":"Custom build tool tasks that provide commands to run before or during the build. See ","type":"text"},{"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/EnableBuildPlugin","isActive":true,"type":"reference"},{"text":" to see how to add an existing build plugin, or ","type":"text"},{"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/WritingBuildToolPlugin","isActive":true,"type":"reference"},{"text":" to write your own.","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"Build Plugin","type":"text"}]}},{"definition":{"content":[{"inlineContent":[{"text":"Custom commands that you run using the ","type":"text"},{"code":"swift package","type":"codeVoice"},{"text":" command line interface. See ","type":"text"},{"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/EnableCommandPlugin","isActive":true,"type":"reference"},{"text":" to see how to add an existing command plugin, or ","type":"text"},{"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/WritingCommandPlugin","isActive":true,"type":"reference"},{"text":" to write your own.","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"Command Plugin","type":"text"}]}}],"type":"termList"},{"anchor":"Plugin-Capabilities","level":3,"text":"Plugin Capabilities","type":"heading"},{"inlineContent":[{"text":"Plugins have access to a representation of the package model.","type":"text"},{"text":" ","type":"text"},{"text":"Command plugins can also invoke services provided by package manager to build and test products and targets defined in the package to which the plugin is applied.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every plugin runs as a separate process from the package manager.","type":"text"},{"text":" ","type":"text"},{"text":"On platforms that support sandboxing, package manager wraps the plugin in a sandbox that prevents network access and attempts to write to arbitrary locations in the file system.","type":"text"},{"text":" ","type":"text"},{"text":"All plugins can write to a temporary directory.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Custom command plugins that need to modify the package source code can specify this requirement.","type":"text"},{"text":" ","type":"text"},{"text":"If the user approves, package manager grants write access to the package directory.","type":"text"},{"text":" ","type":"text"},{"text":"Build tool plugins can’t modify the package source code.","type":"text"}],"type":"paragraph"},{"anchor":"Creating-Plugins","level":3,"text":"Creating Plugins","type":"heading"},{"inlineContent":[{"text":"When creating a plugin, represent a plugin in the package manifest as a target of the ","type":"text"},{"code":"pluginTarget","type":"codeVoice"},{"text":" type.","type":"text"},{"text":" ","type":"text"},{"text":"If it should be available to other packages, also include a corresponding ","type":"text"},{"code":"pluginProduct","type":"codeVoice"},{"text":" target.","type":"text"},{"text":" ","type":"text"},{"text":"Source code for a plugin is normally located in a directory under the ","type":"text"},{"code":"Plugins","type":"codeVoice"},{"text":" directory in the package, but this can be customized.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A plugin declares which extension point it implements by defining the plugin’s ","type":"text"},{"inlineContent":[{"text":"capability","type":"text"}],"type":"emphasis"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"This determines the entry point through which package manager will call it, and determines which actions the plugin can perform.","type":"text"}],"type":"paragraph"},{"anchor":"References","level":3,"text":"References","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"“Meet Swift Package plugins” ","type":"text"},{"identifier":"https://developer.apple.com/videos/play/wwdc2022-110359","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"“Create Swift Package plugins” ","type":"text"},{"identifier":"https://developer.apple.com/videos/play/wwdc2022-110401","isActive":true,"type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Extending-Package-Manager","generated":true,"identifiers":["doc://PackageManagerDocs/documentation/PackageManagerDocs/SwiftPMAsALibrary"],"title":"Extending Package Manager"}],"topicSections":[{"anchor":"Enabling-Plugins","identifiers":["doc://PackageManagerDocs/documentation/PackageManagerDocs/EnableCommandPlugin","doc://PackageManagerDocs/documentation/PackageManagerDocs/EnableBuildPlugin"],"title":"Enabling Plugins"},{"anchor":"Writing-Plugins","identifiers":["doc://PackageManagerDocs/documentation/PackageManagerDocs/WritingCommandPlugin","doc://PackageManagerDocs/documentation/PackageManagerDocs/WritingBuildToolPlugin"],"title":"Writing Plugins"}],"references":{"doc://PackageManagerDocs/documentation/PackageManagerDocs":{"abstract":[{"text":"Organize, manage, and edit Swift packages.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs","kind":"symbol","navigatorTitle":[{"kind":"text","text":"Swift Package Manager"}],"role":"collection","title":"Swift Package Manager","type":"topic","url":"/documentation/packagemanagerdocs"},"doc://PackageManagerDocs/documentation/PackageManagerDocs/EnableBuildPlugin":{"abstract":[{"text":"Extend the package manager with a build plugin from another package.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/EnableBuildPlugin","kind":"article","role":"article","title":"Enable a build plugin","type":"topic","url":"/documentation/packagemanagerdocs/enablebuildplugin"},"doc://PackageManagerDocs/documentation/PackageManagerDocs/EnableCommandPlugin":{"abstract":[{"text":"Extend package manager commands with a command plugin from another package.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/EnableCommandPlugin","kind":"article","role":"article","title":"Enable a command plugin","type":"topic","url":"/documentation/packagemanagerdocs/enablecommandplugin"},"doc://PackageManagerDocs/documentation/PackageManagerDocs/SwiftPMAsALibrary":{"abstract":[{"text":"Include Swift Package Manager as a dependency in your Swift package.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/SwiftPMAsALibrary","kind":"article","role":"article","title":"Swift Package Manager as a library","type":"topic","url":"/documentation/packagemanagerdocs/swiftpmasalibrary"},"doc://PackageManagerDocs/documentation/PackageManagerDocs/WritingBuildToolPlugin":{"abstract":[{"text":"Create a build tool to process or generate files.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/WritingBuildToolPlugin","kind":"article","role":"article","title":"Writing a build tool plugin","type":"topic","url":"/documentation/packagemanagerdocs/writingbuildtoolplugin"},"doc://PackageManagerDocs/documentation/PackageManagerDocs/WritingCommandPlugin":{"abstract":[{"text":"Create a command plugin to provide commands that extend the package manager.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/WritingCommandPlugin","kind":"article","role":"article","title":"Writing a command plugin","type":"topic","url":"/documentation/packagemanagerdocs/writingcommandplugin"},"https://developer.apple.com/videos/play/wwdc2022-110359":{"identifier":"https://developer.apple.com/videos/play/wwdc2022-110359","title":"WWDC22 session","titleInlineContent":[{"text":"WWDC22 session","type":"text"}],"type":"link","url":"https://developer.apple.com/videos/play/wwdc2022-110359"},"https://developer.apple.com/videos/play/wwdc2022-110401":{"identifier":"https://developer.apple.com/videos/play/wwdc2022-110401","title":"WWDC22 session","titleInlineContent":[{"text":"WWDC22 session","type":"text"}],"type":"link","url":"https://developer.apple.com/videos/play/wwdc2022-110401"}}}