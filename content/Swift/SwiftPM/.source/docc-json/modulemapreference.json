{"abstract":[{"text":"A reference of module map directives, attributes, and syntax for defining C and C++ module interfaces.","type":"text"}],"hierarchy":{"paths":[["doc://PackageManagerDocs/documentation/PackageManagerDocs","doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMaps"]]},"identifier":{"interfaceLanguage":"swift","url":"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMapReference"},"kind":"article","metadata":{"modules":[{"name":"Swift Package Manager"}],"role":"article","roleHeading":"Article","title":"Module Map Syntax Reference"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Module maps use a domain-specific language to describe how C, Objective-C, and C++ headers are organized into modules.","type":"text"},{"text":" ","type":"text"},{"text":"This reference documents the syntax and semantics of module map declarations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For instructions on creating module maps, see ","type":"text"},{"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMaps","isActive":true,"type":"reference"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"For troubleshooting and testing module maps, see ","type":"text"},{"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/DebuggingModuleMaps","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The ","type":"text"},{"identifier":"https://clang.llvm.org/docs/Modules.html","isActive":true,"type":"reference"},{"text":" is the official specification for module maps.","type":"text"},{"text":" ","type":"text"},{"text":"The content below summarizes that reference for common Swift use cases.","type":"text"}],"type":"paragraph"},{"anchor":"Module-declarations","level":2,"text":"Module declarations","type":"heading"},{"inlineContent":[{"text":"A module declaration defines a named module and specifies its contents.","type":"text"}],"type":"paragraph"},{"anchor":"Basic-syntax","level":3,"text":"Basic syntax","type":"heading"},{"code":["module ModuleName {","    declarations","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The module name must be a valid identifier.","type":"text"},{"text":" ","type":"text"},{"text":"It can contain letters, numbers, and underscores, but can’t start with a number.","type":"text"},{"text":" ","type":"text"},{"text":"The module name must match the product or target name in Swift Package Manager.","type":"text"}],"type":"paragraph"},{"anchor":"Framework-modules","level":3,"text":"Framework modules","type":"heading"},{"inlineContent":[{"text":"Framework modules use a specialized syntax for macOS and iOS frameworks:","type":"text"}],"type":"paragraph"},{"code":["framework module FrameworkName {","    umbrella header \"FrameworkName.h\"","    export *","    module * { export * }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"framework","type":"codeVoice"},{"text":" keyword indicates the module represents a framework bundle.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":"module * { export * }","type":"codeVoice"},{"text":" pattern automatically creates and exports submodules for all headers.","type":"text"}],"type":"paragraph"},{"anchor":"Explicit-submodules","level":3,"text":"Explicit submodules","type":"heading"},{"inlineContent":[{"text":"Submodules divide a module into smaller units:","type":"text"}],"type":"paragraph"},{"code":["module ParentModule {","    explicit module SubmoduleA {","        header \"SubA.h\"","        export *","    }","","    explicit module SubmoduleB {","        header \"SubB.h\"","        export *","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"explicit","type":"codeVoice"},{"text":" keyword requires clients to explicitly import the submodule.","type":"text"},{"text":" ","type":"text"},{"text":"Code imports explicit submodules with ","type":"text"},{"code":"import ParentModule.SubmoduleA","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Without the ","type":"text"},{"code":"explicit","type":"codeVoice"},{"text":" keyword, the submodule is imported automatically when the parent module is imported.","type":"text"}],"type":"paragraph"},{"anchor":"Header-declarations","level":3,"text":"Header declarations","type":"heading"},{"inlineContent":[{"text":"Header declarations specify which header files belong to a module.","type":"text"}],"type":"paragraph"},{"anchor":"header","level":4,"text":"header","type":"heading"},{"inlineContent":[{"text":"Includes a header file in the module:","type":"text"}],"type":"paragraph"},{"code":["header \"HeaderName.h\""],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The path is relative to the module map file’s location.","type":"text"},{"text":" ","type":"text"},{"text":"The compiler parses the header and makes its declarations available when the module is imported.","type":"text"}],"type":"paragraph"},{"anchor":"umbrella-header","level":4,"text":"umbrella header","type":"heading"},{"inlineContent":[{"text":"Includes a header that itself includes all other public headers:","type":"text"}],"type":"paragraph"},{"code":["umbrella header \"ModuleName.h\""],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Umbrella headers provide a single entry point for all module functionality.","type":"text"},{"text":" ","type":"text"},{"text":"The header typically includes all other public headers with ","type":"text"},{"code":"#include","type":"codeVoice"},{"text":" directives.","type":"text"}],"type":"paragraph"},{"anchor":"private-header","level":4,"text":"private header","type":"heading"},{"inlineContent":[{"text":"Includes a header that’s only visible within the module implementation:","type":"text"}],"type":"paragraph"},{"code":["private header \"InternalAPI.h\""],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Private headers aren’t visible to clients that import the module.","type":"text"},{"text":" ","type":"text"},{"text":"Use private headers for implementation details that other files within the module need to access.","type":"text"}],"type":"paragraph"},{"anchor":"textual-header","level":4,"text":"textual header","type":"heading"},{"inlineContent":[{"text":"Includes a header that’s textually included rather than compiled as part of the module:","type":"text"}],"type":"paragraph"},{"code":["textual header \"Macros.h\""],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Textual headers are typically used for macro-only headers or headers that can’t be parsed in isolation.","type":"text"},{"text":" ","type":"text"},{"text":"The compiler includes the header’s contents directly into each translation unit rather than precompiling it as part of the module.","type":"text"}],"type":"paragraph"},{"anchor":"exclude-header","level":4,"text":"exclude header","type":"heading"},{"inlineContent":[{"text":"Explicitly excludes a header from an umbrella:","type":"text"}],"type":"paragraph"},{"code":["umbrella header \"Module.h\"","exclude header \"Internal.h\""],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"When using an umbrella header that includes files you don’t want in the module, use ","type":"text"},{"code":"exclude header","type":"codeVoice"},{"text":" to omit specific headers.","type":"text"}],"type":"paragraph"},{"anchor":"umbrella-directory","level":4,"text":"umbrella directory","type":"heading"},{"inlineContent":[{"text":"Includes all headers in a directory:","type":"text"}],"type":"paragraph"},{"code":["umbrella \"include\""],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The compiler includes all headers found in the specified directory and its subdirectories.","type":"text"},{"text":" ","type":"text"},{"text":"This is less common than umbrella headers because it provides less control over which headers are public.","type":"text"}],"type":"paragraph"},{"anchor":"Export-declarations","level":3,"text":"Export declarations","type":"heading"},{"inlineContent":[{"text":"Export declarations control which modules are re-exported to clients.","type":"text"}],"type":"paragraph"},{"anchor":"export-","level":4,"text":"export *","type":"heading"},{"inlineContent":[{"text":"Re-exports all imported modules:","type":"text"}],"type":"paragraph"},{"code":["export *"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"When a client imports your module, they also see declarations from modules your module imports.","type":"text"},{"text":" ","type":"text"},{"text":"This is the most common export pattern for C libraries.","type":"text"}],"type":"paragraph"},{"anchor":"Selective-exports","level":4,"text":"Selective exports","type":"heading"},{"inlineContent":[{"text":"Re-exports specific modules:","type":"text"}],"type":"paragraph"},{"code":["module MyModule {","    header \"MyModule.h\"","    export Foundation","    export Darwin","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Only the specified modules are visible to clients.","type":"text"},{"text":" ","type":"text"},{"text":"Modules imported but not exported remain private implementation details.","type":"text"}],"type":"paragraph"},{"anchor":"Link-declarations","level":3,"text":"Link declarations","type":"heading"},{"inlineContent":[{"text":"Link declarations specify libraries the linker should include.","type":"text"}],"type":"paragraph"},{"anchor":"Basic-syntax","level":4,"text":"Basic syntax","type":"heading"},{"code":["link \"libraryname\""],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Specify the library name without the ","type":"text"},{"code":"lib","type":"codeVoice"},{"text":" prefix or file extension.","type":"text"},{"text":" ","type":"text"},{"text":"For example, use ","type":"text"},{"code":"link \"z\"","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"libz.a","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"libz.dylib","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The build system passes this information to the linker automatically.","type":"text"}],"type":"paragraph"},{"anchor":"Framework-links","level":4,"text":"Framework links","type":"heading"},{"inlineContent":[{"text":"For macOS and iOS frameworks:","type":"text"}],"type":"paragraph"},{"code":["link framework \"FrameworkName\""],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"This tells the linker to link against the specified framework.","type":"text"}],"type":"paragraph"},{"anchor":"Requirements","level":3,"text":"Requirements","type":"heading"},{"inlineContent":[{"text":"Requirements specify conditions that must be met for the module to be available.","type":"text"}],"type":"paragraph"},{"anchor":"Language-requirements","level":4,"text":"Language requirements","type":"heading"},{"items":[{"definition":{"content":[{"inlineContent":[{"text":"Requires C++ language support","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"cplusplus","type":"text"}]}},{"definition":{"content":[{"inlineContent":[{"text":"Requires C++11 or later","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"cplusplus11","type":"text"}]}},{"definition":{"content":[{"inlineContent":[{"text":"Requires C++14 or later","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"cplusplus14","type":"text"}]}},{"definition":{"content":[{"inlineContent":[{"text":"Requires C++17 or later","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"cplusplus17","type":"text"}]}},{"definition":{"content":[{"inlineContent":[{"text":"Requires C++20 or later","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"cplusplus20","type":"text"}]}},{"definition":{"content":[{"inlineContent":[{"text":"Requires Objective-C language support","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"objc","type":"text"}]}},{"definition":{"content":[{"inlineContent":[{"text":"Requires OpenCL support","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"opencl","type":"text"}]}}],"type":"termList"},{"inlineContent":[{"text":"Example:","type":"text"}],"type":"paragraph"},{"code":["module CppLibrary {","    header \"CppLibrary.h\"","    requires cplusplus11","    export *","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The compiler rejects the module if the build doesn’t satisfy the requirements.","type":"text"}],"type":"paragraph"},{"anchor":"Feature-requirements","level":4,"text":"Feature requirements","type":"heading"},{"items":[{"definition":{"content":[{"inlineContent":[{"text":"Requires blocks (closures) support","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"blocks","type":"text"}]}},{"definition":{"content":[{"inlineContent":[{"text":"Requires GNU inline assembly support","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"gnuinlineasm","type":"text"}]}}],"type":"termList"},{"inlineContent":[{"text":"Use the negation operator to exclude features:","type":"text"}],"type":"paragraph"},{"code":["requires !gnuinlineasm"],"syntax":null,"type":"codeListing"},{"anchor":"Combining-requirements","level":4,"text":"Combining requirements","type":"heading"},{"inlineContent":[{"text":"Combine multiple requirements with commas:","type":"text"}],"type":"paragraph"},{"code":["requires cplusplus, !blocks"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"All requirements must be satisfied for the module to be available.","type":"text"}],"type":"paragraph"},{"anchor":"Module-attributes","level":3,"text":"Module attributes","type":"heading"},{"inlineContent":[{"text":"Attributes modify module behavior and semantics.","type":"text"}],"type":"paragraph"},{"anchor":"system","level":4,"text":"[system]","type":"heading"},{"inlineContent":[{"text":"Marks a module as a system module:","type":"text"}],"type":"paragraph"},{"code":["module SystemLibrary [system] {","    header \"system.h\"","    export *","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"System modules receive special treatment:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Compiler warnings in system headers are suppressed","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Swift imports certain Objective-C types differently (","type":"text"},{"code":"NSUInteger","type":"codeVoice"},{"text":" becomes ","type":"text"},{"code":"Int","type":"codeVoice"},{"text":" instead of ","type":"text"},{"code":"UInt","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The attribute ensures consistent behavior between local builds and client builds","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"[system]","type":"codeVoice"},{"text":" for SDK-provided libraries and system headers.","type":"text"}],"type":"paragraph"},{"anchor":"externc","level":4,"text":"[extern_c]","type":"heading"},{"inlineContent":[{"text":"Indicates C linkage for C++ code:","type":"text"}],"type":"paragraph"},{"code":["module [extern_c] CLibrary {","    header \"clib.h\"","    export *","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"This is useful when wrapping C libraries in C++ contexts.","type":"text"}],"type":"paragraph"},{"anchor":"noundeclaredincludes","level":4,"text":"[no_undeclared_includes]","type":"heading"},{"inlineContent":[{"text":"Prevents implicit inclusion of headers:","type":"text"}],"type":"paragraph"},{"code":["module StrictModule [no_undeclared_includes] {","    header \"StrictModule.h\"","    export *","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Clients must explicitly import all modules they use.","type":"text"},{"text":" ","type":"text"},{"text":"This makes dependencies explicit and prevents accidental reliance on transitive includes.","type":"text"}],"type":"paragraph"},{"anchor":"Configuration-macros","level":3,"text":"Configuration macros","type":"heading"},{"inlineContent":[{"text":"Configuration macros allow different module variants based on preprocessor definitions.","type":"text"}],"type":"paragraph"},{"anchor":"configmacros","level":4,"text":"config_macros","type":"heading"},{"inlineContent":[{"text":"Declares macros that affect the module’s interface:","type":"text"}],"type":"paragraph"},{"code":["module ConfigurableModule {","    header \"ConfigurableModule.h\"","    config_macros exhaustive DEBUG_MODE, FEATURE_X","    export *","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"exhaustive","type":"codeVoice"},{"text":" keyword lists all macros that affect the module’s API.","type":"text"},{"text":" ","type":"text"},{"text":"The compiler creates separate module variants for different macro combinations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Without configuration macros declared, the compiler assumes the module’s interface is independent of preprocessor state.","type":"text"}],"type":"paragraph"},{"anchor":"Conflict-declarations","level":3,"text":"Conflict declarations","type":"heading"},{"inlineContent":[{"text":"Conflict declarations specify incompatible modules.","type":"text"}],"type":"paragraph"},{"anchor":"conflict","level":4,"text":"conflict","type":"heading"},{"inlineContent":[{"text":"Declares that a module conflicts with another:","type":"text"}],"type":"paragraph"},{"code":["module NewModule {","    header \"NewModule.h\"","    conflict OldModule, \"Use NewModule instead\"","    export *","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The compiler produces an error if both modules are imported in the same translation unit.","type":"text"},{"text":" ","type":"text"},{"text":"The message explains why the modules conflict, and what to do instead.","type":"text"}],"type":"paragraph"},{"anchor":"Extern-modules","level":3,"text":"Extern modules","type":"heading"},{"inlineContent":[{"text":"Extern modules reference module maps in other files.","type":"text"}],"type":"paragraph"},{"anchor":"extern-module","level":4,"text":"extern module","type":"heading"},{"inlineContent":[{"text":"References a module defined in another module map:","type":"text"}],"type":"paragraph"},{"code":["extern module ExternalModule \"path/to/other.modulemap\""],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"This allows organizing large module hierarchies across multiple files.","type":"text"},{"text":" ","type":"text"},{"text":"The path is relative to the current module map file.","type":"text"}],"type":"paragraph"},{"anchor":"Use-declarations","level":3,"text":"Use declarations","type":"heading"},{"inlineContent":[{"text":"Use declarations specify dependencies between modules.","type":"text"}],"type":"paragraph"},{"anchor":"use","level":4,"text":"use","type":"heading"},{"inlineContent":[{"text":"Declares that a module depends on another:","type":"text"}],"type":"paragraph"},{"code":["module DependentModule {","    header \"DependentModule.h\"","    use Foundation","    export *","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"This is informational and helps document module dependencies.","type":"text"},{"text":" ","type":"text"},{"text":"Most module maps don’t need explicit ","type":"text"},{"code":"use","type":"codeVoice"},{"text":" declarations.","type":"text"}],"type":"paragraph"},{"anchor":"Complete-syntax-example","level":2,"text":"Complete syntax example","type":"heading"},{"inlineContent":[{"text":"A comprehensive module map demonstrating multiple features:","type":"text"}],"type":"paragraph"},{"code":["module CompleteExample [system] {","    // Main module","    umbrella header \"CompleteExample.h\"","    export *","","    // Configuration","    config_macros exhaustive DEBUG, LOGGING_ENABLED","","    // Linking","    link \"example\"","","    // Requirements","    requires !gnuinlineasm","","    // Explicit submodule","    explicit module Utilities {","        header \"Utilities.h\"","        export *","    }","","    // Private implementation submodule","    explicit module Private {","        private header \"CompleteExample_Private.h\"","        export *","    }","","    // C++ submodule","    explicit module CPP {","        header \"CompleteExample_CPP.hpp\"","        requires cplusplus11","        export *","    }","}","","// Backward compatibility module","module CompleteExampleOld {","    header \"CompleteExample_Old.h\"","    conflict CompleteExample, \"Use CompleteExample instead of CompleteExampleOld\"","    export *","}"],"syntax":null,"type":"codeListing"},{"anchor":"Module-map-file-naming","level":2,"text":"Module map file naming","type":"heading"},{"inlineContent":[{"text":"Module map files must follow specific naming conventions:","type":"text"}],"type":"paragraph"},{"items":[{"definition":{"content":[{"inlineContent":[{"text":"Standard public module map","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"module.modulemap","type":"text"}]}},{"definition":{"content":[{"inlineContent":[{"text":"Private module map for implementation details","type":"text"}],"type":"paragraph"}]},"term":{"inlineContent":[{"text":"module.private.modulemap","type":"text"}]}}],"type":"termList"},{"inlineContent":[{"text":"Swift Package Manager looks for ","type":"text"},{"code":"module.modulemap","type":"codeVoice"},{"text":" by default.","type":"text"}],"type":"paragraph"},{"anchor":"System-library-wrapper","level":3,"text":"System library wrapper","type":"heading"},{"code":["module SystemLib [system] {","    header \"shim.h\"","    link \"systemlib\"","    export *","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The shim header includes the actual system header, allowing the compiler to find it through search paths.","type":"text"}],"type":"paragraph"},{"anchor":"C++-library","level":3,"text":"C++ library","type":"heading"},{"code":["module CppLib {","    header \"CppLib.hpp\"","    requires cplusplus11","    export *","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"requires cplusplus11","type":"codeVoice"},{"text":" directive ensures the module is only available in C++11 mode or later.","type":"text"}],"type":"paragraph"},{"anchor":"Framework-with-submodules","level":3,"text":"Framework with submodules","type":"heading"},{"code":["framework module MyFramework {","    umbrella header \"MyFramework.h\"","    export *","    module * { export * }","","    explicit module Private {","        private header \"MyFramework_Private.h\"","        export *","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Public headers are automatically modularized, while private headers require explicit import.","type":"text"}],"type":"paragraph"},{"anchor":"Multiple-libraries","level":3,"text":"Multiple libraries","type":"heading"},{"code":["module CompositeLib {","    module Core {","        header \"Core.h\"","        link \"core\"","        export *","    }","","    module Utils {","        header \"Utils.h\"","        link \"utils\"","        export *","    }","}"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"text":"Each submodule can link to its own library.","type":"text"}],"type":"paragraph"},{"anchor":"Diagnostic-directives","level":2,"text":"Diagnostic directives","type":"heading"},{"inlineContent":[{"text":"Module maps don’t support preprocessor directives like ","type":"text"},{"code":"#if","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"#ifdef","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"All content in a module map is always active.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To handle platform-specific headers, use separate module maps for each platform or use requirements:","type":"text"}],"type":"paragraph"},{"code":["module CrossPlatform {","    // Common headers","    header \"Common.h\"","","    // Platform-specific via requirements","    module Darwin {","        requires objc","        header \"Darwin.h\"","        export *","    }","","    export *","}"],"syntax":null,"type":"codeListing"},{"anchor":"Module-map-parsing","level":2,"text":"Module map parsing","type":"heading"},{"inlineContent":[{"text":"The compiler parses module maps with these characteristics:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Comments use C++ style (","type":"text"},{"code":"//","type":"codeVoice"},{"text":") or C style (","type":"text"},{"code":"/* */","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Identifiers follow C naming rules (letters, digits, underscores).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"String literals use double quotes.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Paths in string literals are relative to the module map file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Whitespace is insignificant outside string literals.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Module map files must be valid UTF-8.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Limitations-and-constraints","level":2,"text":"Limitations and constraints","type":"heading"},{"inlineContent":[{"text":"Module maps have several limitations:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Module names can’t contain periods (use submodules instead).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Header paths must be relative to the module map file.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Circular dependencies between modules aren’t supported.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Conditional compilation directives aren’t supported in module maps.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Module maps assume headers are well-formed and can be parsed in isolation.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Integration-with-Swift-Package-Manager","level":2,"text":"Integration with Swift Package Manager","type":"heading"},{"inlineContent":[{"text":"Swift Package Manager uses module maps to bridge C and C++ libraries:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The ","type":"text"},{"code":"moduleMapPath","type":"codeVoice"},{"text":" field in artifact bundles specifies the module map location.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"System library targets place module maps in the target directory.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The build system automatically adds ","type":"text"},{"code":"-fmodule-map-file=","type":"codeVoice"},{"text":" flags.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Module names must match binary target or system library target names.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"For instructions on creating a module map, see ","type":"text"},{"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMaps","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Best-practices","level":2,"text":"Best practices","type":"heading"},{"inlineContent":[{"text":"Follow these practices when writing module maps:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Use ","type":"text"},{"code":"[system]","type":"codeVoice"},{"text":" for SDK and system library modules.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Specify ","type":"text"},{"code":"requires cplusplus","type":"codeVoice"},{"text":" for any C++ code.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use umbrella headers for multi-header libraries.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Keep module names simple and descriptive.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Match module names to artifact names exactly.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use relative paths for all header references.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Document configuration macros with ","type":"text"},{"code":"exhaustive","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Test module maps on all target platforms.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use explicit submodules for optional functionality.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Keep module maps minimal and focused.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["https://clang.llvm.org/docs/Modules.html","doc://PackageManagerDocs/documentation/PackageManagerDocs/DebuggingModuleMaps"],"title":"Related Documentation"},{"generated":true,"identifiers":["doc://PackageManagerDocs/documentation/PackageManagerDocs/DebuggingModuleMaps"]}],"references":{"doc://PackageManagerDocs/documentation/PackageManagerDocs":{"abstract":[{"text":"Organize, manage, and edit Swift packages.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs","kind":"symbol","navigatorTitle":[{"kind":"text","text":"Swift Package Manager"}],"role":"collection","title":"Swift Package Manager","type":"topic","url":"/documentation/packagemanagerdocs"},"doc://PackageManagerDocs/documentation/PackageManagerDocs/DebuggingModuleMaps":{"abstract":[{"text":"Diagnose and resolve issues when Swift can’t import your C or C++ libraries.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/DebuggingModuleMaps","kind":"article","role":"article","title":"Debugging Module Maps","type":"topic","url":"/documentation/packagemanagerdocs/debuggingmodulemaps"},"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMaps":{"abstract":[{"text":"Define how C and C++ headers are exposed to Swift for system library targets, precompiled libraries, or C Language targets.","type":"text"}],"identifier":"doc://PackageManagerDocs/documentation/PackageManagerDocs/ModuleMaps","kind":"article","role":"collectionGroup","title":"Creating Module Maps","type":"topic","url":"/documentation/packagemanagerdocs/modulemaps"},"https://clang.llvm.org/docs/Modules.html":{"identifier":"https://clang.llvm.org/docs/Modules.html","title":"Clang Modules Documentation","titleInlineContent":[{"text":"Clang Modules Documentation","type":"text"}],"type":"link","url":"https://clang.llvm.org/docs/Modules.html"}}}