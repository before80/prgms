:"A launch scene for document-based applications.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DocumentGroupLaunchScene"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DocumentGroupLaunchScene","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DocumentGroupLaunchScene"}],"role":"symbol","title":"DocumentGroupLaunchScene","type":"topic","url":"\/documentation\/swiftui\/documentgrouplaunchscene"},"doc://com.apple.SwiftUI/documentation/SwiftUI/DocumentGroupLaunchScene/init(_:_:background:overlayAccessoryView:)":{"abstract":[{"text":"Creates a launch scene for document-based applications with a title, a","type":"text"},{"text":" ","type":"text"},{"text":"set of actions, a background, and an overlay accessory view.","type":"text"}],"conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}],"constraints":[{"code":"Actions","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"View","type":"codeVoice"},{"text":".","type":"text"}]},"fragments":[{"kind":"identifier","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":":"},{"kind":"externalParam","text":"_"},{"kind":"text","text":":"},{"kind":"externalParam","text":"background"},{"kind":"text","text":":"},{"kind":"externalParam","text":"overlayAccessoryView"},{"kind":"text","text":":)"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DocumentGroupLaunchScene\/init(_:_:background:overlayAccessoryView:)","kind":"symbol","navigatorTitle":[{"kind":"keyword","text":"init"},{"kind":"text","text":"("},{"kind":"externalParam","text":"_"},{"kind":"text","text":":"},{"kind":"externalParam","text":"_"},{"kind":"text","text":":"},{"kind":"externalParam","text":"background"},{"kind":"text","text":":"},{"kind":"externalParam","text":"overlayAccessoryView"},{"kind":"text","tex