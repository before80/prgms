{"abstract":[{"text":"Create, save, and open documents in a multiplatform app.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Documents"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Building-a-document-based-app-with-SwiftUI"},"kind":"article","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"images":[{"identifier":"Building-a-document-based-app-PageImage-card.png","type":"card"}],"modules":[{"name":"SwiftUI"}],"platforms":[{"beta":false,"introducedAt":"27.0","name":"iOS"},{"beta":false,"introducedAt":"27.0","name":"iPadOS"},{"beta":false,"introducedAt":"27.0","name":"Mac Catalyst"},{"beta":false,"introducedAt":"27.0","name":"macOS"},{"beta":false,"introducedAt":"27.0","name":"Xcode"}],"role":"sampleCode","roleHeading":"Sample Code","title":"Building a document-based app with SwiftUI"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"With this sample app, people can create, save, and open checklist documents on iPhone, iPad, Mac, and Vision Pro. In the app, people can also:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Add, delete, and reorder checklist items.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select and deselect items to mark them complete.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Undo and redo their changes.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The app uses SwiftUI’s ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DocumentGroup","isActive":true,"type":"reference"},{"text":" scene and ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Document","isActive":true,"type":"reference"},{"text":" protocol to open, save, and manage checklist files, and registers its own custom document type so the system knows to open checklist files with this app.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"writing-app-ipad.png","metadata":{"deviceFrame":"iPadPro12-9"},"type":"image"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"This sample targets the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Document","isActive":true,"type":"reference"},{"text":" protocol described in ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Creating-a-document-based-app","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Updating-your-document-based-app","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"anchor":"Configure-the-sample-code-project","level":2,"text":"Configure the sample code project","type":"heading"},{"inlineContent":[{"text":"To build and run this sample on your device, select your development team for the project’s target using these steps:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Open the sample with the latest version of Xcode.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Select the top-level project.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For the project’s target, choose your team from the Team pop-up menu in the Signing & Capabilities pane to let Xcode automatically manage your provisioning profile.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Create-the-data-model","level":2,"text":"Create the data model","type":"heading"},{"inlineContent":[{"text":"This sample has a data model that defines a checklist as a collection of items. Each item has a title and a Boolean value that tracks whether someone checked it off. ","type":"text"},{"code":"ChecklistItem","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"Checklist","type":"codeVoice"},{"text":" conform to ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Codable","isActive":true,"type":"reference"},{"text":" for serialization, and to ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Identifiable","isActive":true,"type":"reference"},{"text":" for unique identification during enumeration. ","type":"text"},{"code":"ChecklistItem","type":"codeVoice"},{"text":" also conforms to ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Equatable","isActive":true,"type":"reference"},{"text":" so SwiftUI can detect when an item’s content changes, as shown here:","type":"text"}],"type":"paragraph"},{"code":["struct ChecklistItem: Identifiable, Codable, Equatable {","    var id = UUID()","    var isChecked = false","    var title: String","}","","struct Checklist: Identifiable, Codable {","    var id = UUID()","    var items: [ChecklistItem]","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Define-the-apps-scene","level":2,"text":"Define the app’s scene","type":"heading"},{"inlineContent":[{"text":"An app becomes document-based when its first scene in the ","type":"text"},{"code":"App","type":"codeVoice"},{"text":" declaration is either a ","type":"text"},{"code":"DocumentGroup","type":"codeVoice"},{"text":" or a ","type":"text"},{"code":"DocumentGroupLaunchScene","type":"codeVoice"},{"text":". In this sample, the document type conforms to the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Document","isActive":true,"type":"reference"},{"text":" protocol. The ","type":"text"},{"code":"editor","type":"codeVoice"},{"text":" closure of the initializer returns a view that renders the document’s contents, and the ","type":"text"},{"code":"makeDocument","type":"codeVoice"},{"text":" closure creates a new document instance, like this:","type":"text"}],"type":"paragraph"},{"code":["@main","struct DocumentBasedApp: App {","    var body: some Scene {","        DocumentGroup { document in","            ChecklistView(document: document)","        } makeDocument: { configuration, context in","            ChecklistDocument()","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Customize-the-iOS-and-iPadOS-launch-experience","level":2,"text":"Customize the iOS and iPadOS launch experience","type":"heading"},{"inlineContent":[{"text":"You can update the default launch experience on iOS and iPadOS with a custom title, action buttons, and a screen background. To add an action button with a custom label, use ","type":"text"},{"code":"Button","type":"codeVoice"},{"text":". For a button that creates new documents, use a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/NewDocumentButton","isActive":true,"type":"reference"},{"text":" with a custom title. You can customize the background, such as adding a view or a ","type":"text"},{"code":"backgroundStyle","type":"codeVoice"},{"text":" with an initializer, for example, ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DocumentGroupLaunchScene\/init(_:backgroundStyle:_:backgroundAccessoryView:overlayAccessoryView:)-2d13c","isActive":true,"type":"reference"},{"text":". This sample customizes the background of the title view using a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DocumentGroupLaunchScene\/init(_:_:background:overlayAccessoryView:)","isActive":true,"type":"reference"},{"text":" initializer of ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DocumentGroupLaunchScene","isActive":true,"type":"reference"},{"text":", and places a robot and a plant on either side of the title as an overlay accessory view, as shown here:","type":"text"}],"type":"paragraph"},{"code":["DocumentGroupLaunchScene(\"Checklist\") {","    NewDocumentButton(\"Start a Checklist\")","} background: {","    Image(.pinkJungle)","        .resizable()","        .scaledToFill()","} overlayAccessoryView: { _ in","    AccessoryView()","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Because ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DocumentGroupLaunchScene","isActive":true,"type":"reference"},{"text":" isn’t available in macOS, add this scene alongside the sample’s ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DocumentGroup","isActive":true,"type":"reference"},{"text":" scene within an ","type":"text"},{"code":"#if os(iOS)","type":"codeVoice"},{"text":" conditional compilation block.","type":"text"}],"type":"paragraph"},{"anchor":"Adopt-the-document-protocol","level":2,"text":"Adopt the document protocol","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"ChecklistDocument","type":"codeVoice"},{"text":" class adopts the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Document","isActive":true,"type":"reference"},{"text":" protocol to read and write checklists from and to files. Because ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Document","isActive":true,"type":"reference"},{"text":" requires a reference type, ","type":"text"},{"code":"ChecklistDocument","type":"codeVoice"},{"text":" is a ","type":"text"},{"code":"final class","type":"codeVoice"},{"text":" marked with ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Observation\/Observable()","isActive":true,"type":"reference"},{"text":", rather than a structure. The ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ReadableDocument\/readableContentTypes","isActive":true,"type":"reference"},{"text":" property defines the types that the sample can read, specifically, the ","type":"text"},{"code":".checklistDocument","type":"codeVoice"},{"text":" type, like this:","type":"text"}],"type":"paragraph"},{"code":["static let readableContentTypes: [UTType] = [.checklistDocument]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The sample reads a checklist from a file using a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DocumentReader","isActive":true,"type":"reference"},{"text":" that its ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ReadableDocument\/reader(configuration:)","isActive":true,"type":"reference"},{"text":" method returns. This sample uses ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/FileWrapperDocumentReader","isActive":true,"type":"reference"},{"text":" with a closure that decodes a file wrapper’s contents using a ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/JSONDecoder","isActive":true,"type":"reference"},{"text":", as shown here:","type":"text"}],"type":"paragraph"},{"code":["func reader(configuration: sending ReadConfiguration) -> sending FileWrapperDocumentReader<Checklist> {","    FileWrapperDocumentReader(configuration) { fileWrapper in","        guard let data = fileWrapper.regularFileContents else {","            throw CocoaError(.fileReadCorruptFile)","        }","        return try JSONDecoder().decode(Checklist.self, from: data)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"After SwiftUI reads a checklist in the background, it delivers the result to the document’s ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ReadableDocument\/apply(snapshot:previous:)","isActive":true,"type":"reference"},{"text":" method on the main actor, which updates the document’s observable state, like this:","type":"text"}],"type":"paragraph"},{"code":["@MainActor","func apply(snapshot: sending Checklist, previous: sending Checklist?) async throws {","    checklist = snapshot","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When someone saves the document, the sample returns a snapshot of its data from ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/WritableDocument\/snapshot(contentType:)","isActive":true,"type":"reference"},{"text":", which also runs on the main actor as follows:","type":"text"}],"type":"paragraph"},{"code":["@MainActor","func snapshot(contentType: UTType) async throws -> sending Checklist {","    checklist \/\/ Make a copy.","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Conversely, the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/WritableDocument\/writer(configuration:)","isActive":true,"type":"reference"},{"text":" method returns a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DocumentWriter","isActive":true,"type":"reference"},{"text":" that encodes the snapshot and writes it to disk. This sample uses ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/FileWrapperDocumentWriter","isActive":true,"type":"reference"},{"text":" with a closure that serializes the snapshot into a file wrapper using a ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/JSONEncoder","isActive":true,"type":"reference"},{"text":" instance, like this:","type":"text"}],"type":"paragraph"},{"code":["func writer(configuration: sending WriteConfiguration) -> sending FileWrapperDocumentWriter<Checklist> {","    FileWrapperDocumentWriter(configuration) { snapshot, _ in","        let data = try JSONEncoder().encode(snapshot)","        return FileWrapper(regularFileWithContents: data)","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Register-undo-and-redo-actions","level":2,"text":"Register undo and redo actions","type":"heading"},{"inlineContent":[{"text":"With the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Document","isActive":true,"type":"reference"},{"text":" protocol, undo management is mandatory to enable autosave. Read the active ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/UndoManager","isActive":true,"type":"reference"},{"text":" from the environment and update the document through methods that register an undo action. Calling the same method again from the undo closure also registers the redo action, so most operations only need one method, as shown here:","type":"text"}],"type":"paragraph"},{"code":["@MainActor","func toggleItem(_ item: Binding<ChecklistItem>, undoManager: UndoManager? = nil) {","    item.wrappedValue.isChecked.toggle()","","    undoManager?.registerUndo(withTarget: self) { doc in","        doc.toggleItem(item, undoManager: undoManager)","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Export-a-custom-document-type","level":2,"text":"Export a custom document type","type":"heading"},{"inlineContent":[{"text":"The app defines and exports a custom content type for the documents it creates. It declares this custom type in the project’s ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/BundleResources\/Information-Property-List","isActive":true,"type":"reference"},{"text":" file under the ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/BundleResources\/Information-Property-List\/UTExportedTypeDeclarations","isActive":true,"type":"reference"},{"text":" key. This sample uses ","type":"text"},{"code":"com.example.checklist","type":"codeVoice"},{"text":" as the identifier in the information property list file, as the following code demonstrates:","type":"text"}],"type":"paragraph"},{"code":["<key>CFBundleDocumentTypes<\/key>","<array>","    <dict>","        <key>CFBundleTypeRole<\/key>","        <string>Editor<\/string>","        <key>LSHandlerRank<\/key>","        <string>Default<\/string>","        <key>LSItemContentTypes<\/key>","        <array>","            <string>com.example.checklist<\/string>","        <\/array>","        <key>NSUbiquitousDocumentUserActivityType<\/key>","        <string>$(PRODUCT_BUNDLE_IDENTIFIER).example-document<\/string>","    <\/dict>","<\/array>","<key>UTExportedTypeDeclarations<\/key>","<array>","    <dict>","        <key>UTTypeConformsTo<\/key>","        <array>","            <string>public.data<\/string>","            <string>public.content<\/string>","        <\/array>","        <key>UTTypeDescription<\/key>","        <string>Checklist Document<\/string>","        <key>UTTypeIconFiles<\/key>","        <array\/>","        <key>UTTypeIdentifier<\/key>","        <string>com.example.checklist<\/string>","        <key>UTTypeTagSpecification<\/key>","        <dict>","            <key>public.filename-extension<\/key>","            <array>","                <string>checklist<\/string>","            <\/array>","        <\/dict>","    <\/dict>","<\/array>"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For convenience, you can also define the content type in code, as seen in the following example:","type":"text"}],"type":"paragraph"},{"code":["extension UTType {","    static let checklistDocument = UTType(exportedAs: \"com.example.checklist\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Specify a file extension for every custom format you declare to make sure the operating system opens files with the given extension using your app. For more information about custom file and data types, see ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/UniformTypeIdentifiers\/defining-file-and-data-types-for-your-app","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"columns":[{"alignment":"leading","content":[{"anchor":"See-Also","level":2,"text":"See Also","type":"heading"}],"size":1}],"numberOfColumns":1,"type":"row"},{"anchor":"Related-samples","level":4,"text":"Related samples","type":"heading"},{"items":["doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Building-a-document-based-app-using-SwiftData"],"style":"list","type":"links"},{"anchor":"Related-articles","level":4,"text":"Related articles","type":"heading"},{"items":["doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Creating-a-document-based-app","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Updating-your-document-based-app","doc:\/\/com.apple.documentation\/documentation\/UniformTypeIdentifiers\/defining-file-and-data-types-for-your-app"],"style":"list","type":"links"},{"anchor":"Related-videos","level":4,"text":"Related videos","type":"heading"},{"items":["doc:\/\/com.apple.documentation\/videos\/play\/wwdc2026\/269"],"style":"compactGrid","type":"links"}],"kind":"content"}],"sampleCodeDownload":{"action":{"identifier":"c3cf22d725e5\/BuildingADocumentBasedAppWithSwiftUI.zip","isActive":true,"overridingTitle":"Download","type":"reference"},"kind":"sampleDownload"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"variants":[{"paths":["\/documentation\/swiftui\/building-a-document-based-app-with-swiftui"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"ADB00267-2D63-4EBA-B0E7-E2CEBD981FB7":{"alt":null,"identifier":"ADB00267-2D63-4EBA-B0E7-E2CEBD981FB7","type":"image","variants":[{"traits":["1x"],"url":"https:\/\/devimages-cdn.apple.com\/wwdc-services\/images\/9B2E82C5-4DDF-4B9A-9459-328D8E297696\/ADB00267-2D63-4EBA-B0E7-E2CEBD981FB7\/10794_wide_250x141_1x.jpg"},{"traits":["2x"],"url":"