eCaptured","type":"topic","url":"\/documentation\/swiftui\/environmentvalues\/isscenecaptured"},"doc://com.apple.SwiftUI/documentation/SwiftUI/EnvironmentValues/redactionReasons":{"abstract":[{"text":"The current redaction reasons applied to the view hierarchy.","type":"text"}],"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"redactionReasons"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7SwiftUI16RedactionReasonsV","text":"RedactionReasons"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/EnvironmentValues\/redactionReasons","kind":"symbol","role":"symbol","title":"redactionReasons","type":"topic","url":"\/documentation\/swiftui\/environmentvalues\/redactionreasons"},"doc://com.apple.SwiftUI/documentation/SwiftUI/RedactionReasons":{"abstract":[{"text":"The reasons to apply a redaction to data displayed on screen.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RedactionReasons"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/RedactionReasons","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"RedactionReasons"}],"role":"symbol","title":"RedactionReasons","type":"topic","url":"\/documentation\/swiftui\/redactionreasons"},"doc://com.apple.SwiftUI/documentation/SwiftUI/View-configuration":{"abstract":[{"text":"Adjust the characteristics of views in a hierarchy.","type":"text"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View-configuration","kind":"article","role":"collectionGroup","title":"View configuration","type":"topic","url":"\/documentation\/swiftui\/view-configuration"},"doc://com.apple.SwiftUI/documentation/SwiftUI/View/privacySensitive(_:)":{"abstract":[{"text":"Marks the view as containing sensitive, private user data.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text"