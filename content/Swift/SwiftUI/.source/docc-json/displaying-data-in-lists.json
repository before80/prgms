{"abstract":[{"text":"Visualize collections of data with platform-appropriate appearance.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Lists"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Displaying-Data-in-Lists"},"kind":"article","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"modules":[{"name":"SwiftUI"}],"role":"article","roleHeading":"Article","title":"Displaying data in lists"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"Displaying a collection of data in a vertical list is a common requirement in","type":"text"},{"text":" ","type":"text"},{"text":"many apps. Whether it’s a list of contacts, a schedule of events, an index of","type":"text"},{"text":" ","type":"text"},{"text":"categories, or a shopping list, you’ll often find a use for a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/List","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"List views display collections of items vertically, load rows as needed, and","type":"text"},{"text":" ","type":"text"},{"text":"add scrolling when the rows don’t fit on the screen, making them suitable for","type":"text"},{"text":" ","type":"text"},{"text":"displaying large collections of data.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"By default, list views also apply platform-appropriate styling","type":"text"},{"text":" ","type":"text"},{"text":"to their elements. For example, on iOS, the default","type":"text"},{"text":" ","type":"text"},{"text":"configuration of a list displays a separator line between each","type":"text"},{"text":" ","type":"text"},{"text":"row, and adds disclosure indicators next to items that initiate navigation","type":"text"},{"text":" ","type":"text"},{"text":"actions.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"If you want to remove the platform-appropriate styling","type":"text"},{"text":" ","type":"text"},{"text":"— such as row separators or automatic disclosure indicators — from your","type":"text"},{"text":" ","type":"text"},{"text":"list, consider using ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/LazyVStack","isActive":true,"type":"reference"},{"text":" instead. For more","type":"text"},{"text":" ","type":"text"},{"text":"information on working with lazy stacks, see","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Creating-Performant-Scrollable-Stacks","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"inlineContent":[{"text":"The code in this article shows the use of list views to display a","type":"text"},{"text":" ","type":"text"},{"text":"company’s staff directory. Each section enhances the usefulness of the list,","type":"text"},{"text":" ","type":"text"},{"text":"by adding custom cells, splitting the list into sections, and using the list","type":"text"},{"text":" ","type":"text"},{"text":"selection to navigate to a detail view.","type":"text"}],"type":"paragraph"},{"anchor":"Prepare-your-data-for-iteration","level":3,"text":"Prepare your data for iteration","type":"heading"},{"inlineContent":[{"text":"The most common use of ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/List","isActive":true,"type":"reference"},{"text":" is for representing collections of","type":"text"},{"text":" ","type":"text"},{"text":"information in your data model. The following example defines a ","type":"text"},{"code":"Person","type":"codeVoice"},{"text":" as an","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Identifiable","isActive":true,"type":"reference"},{"text":" type with","type":"text"},{"text":" ","type":"text"},{"text":"the properties ","type":"text"},{"code":"name","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"phoneNumber","type":"codeVoice"},{"text":". An array called ","type":"text"},{"code":"staff","type":"codeVoice"},{"text":" contains two","type":"text"},{"text":" ","type":"text"},{"text":"instances of this type.","type":"text"}],"type":"paragraph"},{"code":["struct Person: Identifiable {","     let id = UUID()","     var name: String","     var phoneNumber: String"," }","","var staff = [","    Person(name: \"Juan Chavez\", phoneNumber: \"(408) 555-4301\"),","    Person(name: \"Mei Chen\", phoneNumber: \"(919) 555-2481\")","]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"To present the contents of the array as a list, the example creates a","type":"text"},{"text":" ","type":"text"},{"code":"List","type":"codeVoice"},{"text":" instance. The list’s content builder uses a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ForEach","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"to iterate over the ","type":"text"},{"code":"staff","type":"codeVoice"},{"text":" array. For each member of the array, the listing","type":"text"},{"text":" ","type":"text"},{"text":"creates a row view by instantiating a new ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Text","isActive":true,"type":"reference"},{"text":" that contains the","type":"text"},{"text":" ","type":"text"},{"text":"name of the ","type":"text"},{"code":"Person","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["struct StaffList: View {","    var body: some View {","        List {","            ForEach(staff) { person in","                Text(person.name)","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"Displaying-Data-in-Lists-plain-cells.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"Members of a list must be uniquely identifiable from one another. Unique","type":"text"},{"text":" ","type":"text"},{"text":"identifiers allow SwiftUI to automatically generate animations for changes in","type":"text"},{"text":" ","type":"text"},{"text":"the underlying data, like inserts, deletions, and moves. Identify list members","type":"text"},{"text":" ","type":"text"},{"text":"either by using a type that conforms to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Identifiable","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"code":"Person","type":"codeVoice"},{"text":" does, or by providing an ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" parameter with the key path to a","type":"text"},{"text":" ","type":"text"},{"text":"unique property of the type. The ","type":"text"},{"code":"ForEach","type":"codeVoice"},{"text":" that populates the list","type":"text"},{"text":" ","type":"text"},{"text":"above depends on this behavior, as do the ","type":"text"},{"code":"List","type":"codeVoice"},{"text":" initializers that","type":"text"},{"text":" ","type":"text"},{"text":"take a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Swift\/RandomAccessCollection","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"of members to iterate over.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"The values you use for","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Swift\/Identifiable","isActive":true,"type":"reference"},{"text":" data","type":"text"},{"text":" ","type":"text"},{"text":"must be unique. Using a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/Foundation\/UUID","isActive":true,"type":"reference"},{"text":" or a database","type":"text"},{"text":" ","type":"text"},{"text":"row identifier are both good choices, whereas using data like a person’s name","type":"text"},{"text":" ","type":"text"},{"text":"or phone number could potentially contain duplicates.","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"},{"anchor":"Display-data-inside-a-row","level":3,"text":"Display data inside a row","type":"heading"},{"inlineContent":[{"text":"Each row inside a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/List","isActive":true,"type":"reference"},{"text":" must be a SwiftUI ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View","isActive":true,"type":"reference"},{"text":". You may","type":"text"},{"text":" ","type":"text"},{"text":"be able to represent your data with a single view such as an ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Image","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"or ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Text","isActive":true,"type":"reference"},{"text":" view, or you may need to define a custom view to compose","type":"text"},{"text":" ","type":"text"},{"text":"several views into something more complex.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"As your row views get more sophisticated, refactor the views","type":"text"},{"text":" ","type":"text"},{"text":"into separate view structures, passing in the data that the row needs to","type":"text"},{"text":" ","type":"text"},{"text":"render. The following example defines a ","type":"text"},{"code":"PersonRowView","type":"codeVoice"},{"text":" to create a two-line","type":"text"},{"text":" ","type":"text"},{"text":"view for a ","type":"text"},{"code":"Person","type":"codeVoice"},{"text":", using fonts, colors, and the system “phone” icon image to","type":"text"},{"text":" ","type":"text"},{"text":"visually style the data.","type":"text"}],"type":"paragraph"},{"code":["struct PersonRowView: View {","    var person: Person","","    var body: some View {","        VStack(alignment: .leading, spacing: 3) {","            Text(person.name)","                .foregroundColor(.primary)","                .font(.headline)","            HStack(spacing: 3) {","                Label(person.phoneNumber, systemImage: \"phone\")","            }","            .foregroundColor(.secondary)","            .font(.subheadline)","        }","    }","}","","struct StaffList: View {","    var body: some View {","        List {","            ForEach(staff) { person in","                PersonRowView(person: person)","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"Displaying-Data-in-Lists-custom-cells.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"For more information on composing the types of views commonly used inside","type":"text"},{"text":" ","type":"text"},{"text":"list rows, see ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Building-Layouts-with-Stack-Views","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Represent-data-hierarchy-with-sections","level":3,"text":"Represent data hierarchy with sections","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/List","isActive":true,"type":"reference"},{"text":" views can also display data with a level of hierarchy, grouping","type":"text"},{"text":" ","type":"text"},{"text":"associated data into sections.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Consider an expanded data model that represents an entire company, including","type":"text"},{"text":" ","type":"text"},{"text":"multiple departments. Each ","type":"text"},{"code":"Department","type":"codeVoice"},{"text":" has a name and an array of ","type":"text"},{"code":"Person","type":"codeVoice"},{"text":" ","type":"text"},{"text":"instances, and the company has an array of the ","type":"text"},{"code":"Department","type":"codeVoice"},{"text":" type.","type":"text"}],"type":"paragraph"},{"code":["struct Department: Identifiable {","    let id = UUID()","    var name: String","    var staff: [Person]","}","","struct Company {","    var departments: [Department]","}","","var company = Company(departments: [","    Department(name: \"Sales\", staff: [","        Person(name: \"Juan Chavez\", phoneNumber: \"(408) 555-4301\"),","        Person(name: \"Mei Chen\", phoneNumber: \"(919) 555-2481\"),","        \/\/ ...","    ]),","    Department(name: \"Engineering\", staff: [","        Person(name: \"Bill James\", phoneNumber: \"(408) 555-4450\"),","        Person(name: \"Anne Johnson\", phoneNumber: \"(417) 555-9311\"),","        \/\/ ...","    ]),","    \/\/ ...","])"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Section","isActive":true,"type":"reference"},{"text":" views to give the data inside a ","type":"text"},{"code":"List","type":"codeVoice"},{"text":" a level","type":"text"},{"text":" ","type":"text"},{"text":"of hierarchy. Start by creating the ","type":"text"},{"code":"List","type":"codeVoice"},{"text":", using a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ForEach","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"to iterate over the ","type":"text"},{"code":"company.departments","type":"codeVoice"},{"text":" array, and then create","type":"text"},{"text":" ","type":"text"},{"code":"Section","type":"codeVoice"},{"text":" views for each department. Within the section’s view","type":"text"},{"text":" ","type":"text"},{"text":"builder, use a ","type":"text"},{"code":"ForEach","type":"codeVoice"},{"text":" to iterate over the department’s ","type":"text"},{"code":"staff","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"return a customized view for each ","type":"text"},{"code":"Person","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["List {","    ForEach(company.departments) { department in","        Section {","            ForEach(department.staff) { person in","                PersonRowView(person: person)","            }","        } header: {","            Text(department.name)","        }","    }"," }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"Displaying-Data-in-Lists-sections.png","type":"image"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"If your data hierarchy is too deep to represent with a single level of","type":"text"},{"text":" ","type":"text"},{"text":"sections and rows, ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/OutlineGroup","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DisclosureGroup","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"might be a better fit. These views use a disclosure metaphor to allow someone","type":"text"},{"text":" ","type":"text"},{"text":"to drill down to an arbitrary depth in the hierarchy.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"anchor":"Use-Lists-for-Navigation","level":3,"text":"Use Lists for Navigation","type":"heading"},{"inlineContent":[{"text":"Using a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/NavigationLink","isActive":true,"type":"reference"},{"text":" within a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/List","isActive":true,"type":"reference"},{"text":" contained inside a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/NavigationStack","isActive":true,"type":"reference"},{"text":" adds platform-appropriate visual styling for navigation. SwiftUI navigates to a destination view you provide when a person chooses a list item.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The following example sets up a navigation-based UI by wrapping the","type":"text"},{"text":" ","type":"text"},{"text":"list with a navigation stack. Instances of ","type":"text"},{"code":"NavigationLink","type":"codeVoice"},{"text":" wrap the","type":"text"},{"text":" ","type":"text"},{"text":"list’s rows to provide a ","type":"text"},{"code":"destination","type":"codeVoice"},{"text":" view to navigate to when a person taps","type":"text"},{"text":" ","type":"text"},{"text":"the row.","type":"text"}],"type":"paragraph"},{"code":["NavigationStack {","    List {","        ForEach(company.departments) { department in","            Section {","                ForEach(department.staff) { person in","                    NavigationLink {","                        PersonDetailView(person: person)","                    } label: {","                        PersonRowView(person: person)","                    }","                }","            } header: {","                Text(department.name)","            }","        }","    }","    .navigationTitle(\"Staff Directory\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"In this example, the view passed in as the ","type":"text"},{"code":"destination","type":"codeVoice"},{"text":" is a","type":"text"},{"text":" ","type":"text"},{"code":"PersonDetailView","type":"codeVoice"},{"text":", which repeats the information from the list. In a more","type":"text"},{"text":" ","type":"text"},{"text":"complex app, this detail view could show more information about a ","type":"text"},{"code":"Person","type":"codeVoice"},{"text":" than","type":"text"},{"text":" ","type":"text"},{"text":"would fit inside the list row.","type":"text"}],"type":"paragraph"},{"code":["struct PersonDetailView: View {","    var person: Person","","    var body: some View {","        VStack {","            Text(person.name)","                .foregroundColor(.primary)","                .font(.title)","                .padding()","            HStack {","                Label(person.phoneNumber, systemImage: \"phone\")","            }","            .foregroundColor(.secondary)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For more information about navigation stacks, see ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Understanding-the-navigation-stack","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Creating-a-list","generated":true,"identifiers":["doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/List","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View\/listStyle(_:)"],"title":"Creating a list"}],"variants":[{"paths":["\/documentation\/swiftui\/displaying-data-in-lists"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"Displaying-Data-in-Lists-custom-cells.png":{"alt":"A list with two entries, each showing a name and phone number. Each list item has a two-line cell. The first line shows the name in bold. The second shows a phone icon, followed by the phone number with a plain font and a lighter color.","identifier":"Displaying-Data-in-Lists-custom-cells.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/Displaying-Data-in-Lists-custom-cells@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/Displaying-Data-in-Lists-custom-cells~dark@2x.png"}]},"Displaying-Data-in-Lists-plain-cells.png":{"alt":"A screenshot of a list view, showing a vertical list with two text entries: Juan Chavez and Mei Chen.","identifier":"Displaying-Data-in-Lists-plain-cells.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/Displaying-Data-in-Lists-plain-cells@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/Displaying-Data-in-Lists-plain-cells~dark@2x.png"}]},"Displaying-Data-in-Lists-sections.png":{"alt":"A list with sections. The first has a section header with the title Sales, followed by four person entries as individual rows in this section. The next section, Engineering, contains four entries, followed by Customer Service with two entries.","identifier":"Displaying-Data-in-Lists-sections.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/Displaying-Data-in-Lists-sections@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/Displaying-Data-in-Lists-sections~dark@2x.png"}]},"SwiftUI-PageImage-card.png":{"alt":"A stylized Swift logo using dashes on a white or blue background.","identifier":"SwiftUI-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/SwiftUI-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/SwiftUI-PageImage-card~dark@2x.png"}]},"doc://com.apple.SwiftUI/documentation/SwiftUI":{"abstract":[{"text":"Declare the user interface and behavior for your app on every platform.","type":"text"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI","images":[{"identifier":"SwiftUI-PageImage-card.png","type":"card"}],"kind":"symbol","role":"collection","title":"SwiftUI","type":"topic","url":"\/documentation\/swiftui"},"doc://com.apple.SwiftUI/documentation/SwiftUI/Building-Layouts-with-Stack-Views":{"abstract":[{"text":"Compose complex layouts from primitive container views.","type":"text"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Building-Layouts-with-Stack-Views","kind":"article","role":"article","title":"Building layouts with stack views","type":"topic","url":"\/documentation\/swiftui\/building-layouts-with-stack-views"},"doc://com.apple.SwiftUI/documentation/SwiftUI/Creating-Performant-Scrollable-Stacks":{"abstract":[{"text":"Display large numbers of repeated views efficiently with scroll views, stack","type":"text"},{"text":" ","type":"text"},{"text":"views, and lazy stacks.","type":"text"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Creating-Performant-Scrollable-Stacks","kind":"article","role":"article","title":"Creating performant scrollable stacks","type":"topic","url":"\/documentation\/swiftui\/creating-performant-scrollable-stacks"},"doc://com.apple.SwiftUI/documentation/SwiftUI/DisclosureGroup":{"abstract":[{"text":"A view that shows or hides another content view, based on the state of a","type":"text"},{"text":" ","type":"text"},{"text":"disclosure control.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DisclosureGroup"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DisclosureGroup","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DisclosureGroup"}],"role":"symbol","title":"DisclosureGroup","type":"topic","url":"\/documentation\/swiftui\/disclosuregroup"},"doc://com.apple.SwiftUI/documentation/SwiftUI/ForEach":{"abstract":[{"text":"A structure that computes views on demand from an underlying collection of","type":"text"},{"text":" ","type":"text"},{"text":"identified data.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"ForEach"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ForEach","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"ForEach"}],"role":"symbol","title":"ForEach","type":"topic","url":"\/documentation\/swiftui\/foreach"},"doc://com.apple.SwiftUI/documentation/SwiftUI/Image":{"abstract":[{"text":"A view that displays an image.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"Image"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Image","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Image"}],"role":"symbol","title":"Image","type":"topic","url":"\/documentation\/swiftui\/image"},"doc://com.apple.SwiftUI/documentation/SwiftUI/LazyVStack":{"abstract":[{"text":"A view that arranges its children in a line that grows vertically,","type":"text"},{"text":" ","type":"text"},{"text":"creating items only as needed.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"LazyVStack"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/LazyVStack","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"LazyVStack"}],"role":"symbol","title":"LazyVStack","type":"topic","url":"\/documentation\/swiftui\/lazyvstack"},"doc://com.apple.SwiftUI/documentation/SwiftUI/List":{"abstract":[{"text":"A container that presents rows of data arranged in a single column,","type":"text"},{"text":" ","type":"text"},{"text":"optionally providing the ability to select one or more members.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"List"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/List","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"List"}],"role":"symbol","title":"List","type":"topic","url":"\/documentation\/swiftui\/list"},"doc://com.apple.SwiftUI/documentation/SwiftUI/Lists":{"abstract":[{"text":"