{"abstract":[{"text":"Configure an image to blur and extend under a sidebar or inspector panel.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Landmarks-Building-an-app-with-Liquid-Glass"],["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View-styles","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Landmarks-Building-an-app-with-Liquid-Glass"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Landmarks-Applying-a-background-extension-effect"},"kind":"article","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"images":[{"identifier":"Landmarks-Building-an-app-with-Liquid-Glass-PageImage-card.png","type":"card"}],"modules":[{"name":"SwiftUI"}],"platforms":[{"beta":false,"introducedAt":"26.0","name":"iOS"},{"beta":false,"introducedAt":"26.0","name":"iPadOS"},{"beta":false,"introducedAt":"26.0","name":"Mac Catalyst"},{"beta":false,"introducedAt":"26.0","name":"macOS"},{"beta":false,"introducedAt":"26.0","name":"Xcode"}],"role":"sampleCode","roleHeading":"Sample Code","title":"Landmarks: Applying a background extension effect"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The Landmarks app lets people explore interesting sites around the world. Whether it’s a national park near their home or a far-flung location on a different continent, the app provides a way for people to organize and mark their adventures and receive custom activity badges along the way.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This sample demonstrates how to apply a background extension effect. In the top Landmarks view, the sample applies a background extension effect to the featured image in ","type":"text"},{"code":"LandmarksView","type":"codeVoice"},{"text":", and to the main image in ","type":"text"},{"code":"LandmarkDetailView","type":"codeVoice"},{"text":". The background extension effect blurs and extends the image under the sidebar or inspector panel when open. The following images show the main image in ","type":"text"},{"code":"LandmarkDetailView","type":"codeVoice"},{"text":" both with and without the background extension effect.","type":"text"}],"type":"paragraph"},{"tabs":[{"content":[{"inlineContent":[{"identifier":"Landmarks-Building-an-app-with-Liquid-Glass-2","metadata":{"deviceFrame":"iPadPro12-9"},"type":"image"}],"type":"paragraph"}],"title":"With"},{"content":[{"inlineContent":[{"identifier":"Landmarks-Building-an-app-with-Liquid-Glass-2r","metadata":{"deviceFrame":"iPadPro12-9"},"type":"image"}],"type":"paragraph"}],"title":"Without"}],"type":"tabNavigator"},{"inlineContent":[{"text":"To apply the background extension effect, the sample:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Aligns the view to the leading and trailing edges of the containing view.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Applies the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View\/backgroundExtensionEffect()","isActive":true,"type":"reference"},{"text":" modifier to the view.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Configures only the image in the background extension, and avoids applying the effect to the title and button in the overlay.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Align-the-view-to-the-leading-and-trailing-edges","level":3,"text":"Align the view to the leading and trailing edges","type":"heading"},{"inlineContent":[{"text":"To apply the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View\/backgroundExtensionEffect()","isActive":true,"type":"reference"},{"text":" to a view, align the leading edge of the view next to the sidebar, and align the trailing edge of the view to the trailing edge of the containing view.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"In ","type":"text"},{"code":"LandmarksView","type":"codeVoice"},{"text":", the ","type":"text"},{"code":"LandmarkFeaturedItemView","type":"codeVoice"},{"text":" and the containing ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/LazyVStack","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ScrollView","isActive":true,"type":"reference"},{"text":" don’t have padding. This allows the ","type":"text"},{"code":"LandmarkFeaturedItemView","type":"codeVoice"},{"text":" to align with the leading edge of the view next to the sidebar.","type":"text"}],"type":"paragraph"},{"code":["ScrollView(showsIndicators: false) {","    LazyVStack(alignment: .leading, spacing: Constants.standardPadding) {","        LandmarkFeaturedItemView(landmark: modelData.featuredLandmark!)","            .flexibleHeaderContent()","        \/\/...","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"In ","type":"text"},{"code":"LandmarkDetailView","type":"codeVoice"},{"text":", the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ScrollView","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/VStack","isActive":true,"type":"reference"},{"text":" that contain the main image also don’t have any padding. This allows the main image to align against the leading edge of the containing view.","type":"text"}],"type":"paragraph"},{"anchor":"Apply-the-background-extension-effect-to-the-image","level":3,"text":"Apply the background extension effect to the image","type":"heading"},{"inlineContent":[{"text":"In ","type":"text"},{"code":"LandmarkDetailView","type":"codeVoice"},{"text":", the sample applies the background extension effect to the main image by adding the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View\/backgroundExtensionEffect()","isActive":true,"type":"reference"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"code":["Image(landmark.backgroundImageName)","    \/\/...","    .backgroundExtensionEffect()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"When the sidebar is open, the system extends the image in the leading direction as follows:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The system takes a section of the leading end of the image that matches the width of the sidebar.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The system flips that portion of the image horizontally toward the leading edge and applies a blur to the flipped section.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The system places the modified section of the image under the sidebar, immediately before the leading edge of the image.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"When the inspector is open, the system extends the image in the trailing direction as follows:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The system takes a section of the trailing end of the image that matches the width of the sidebar.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The system flips that portion of the image horizontally toward the trailing edge and applies a blur to the flipped section.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The system places the modified section of the image under the inspector, immediately after the trailing edge of the image.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Configure-only-the-image","level":3,"text":"Configure only the image","type":"heading"},{"inlineContent":[{"text":"In ","type":"text"},{"code":"LandmarksView","type":"codeVoice"},{"text":", the ","type":"text"},{"code":"LandmarkFeaturedItemView","type":"codeVoice"},{"text":" has an image from the featured landmark, and includes a title for the landmark and a button you can click or tap to learn more about that location.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To avoid having the landmark’s title and button appear under the sidebar in macOS, the sample applies the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View\/backgroundExtensionEffect()","isActive":true,"type":"reference"},{"text":" modifier to the image before adding the overlay that includes the title and button:","type":"text"}],"type":"paragraph"},{"code":["Image(decorative: landmark.backgroundImageName)","    \/\/...","    .backgroundExtensionEffect()","    .overlay(alignment: .bottom) {","        VStack {","            Text(\"Featured Landmark\", comment: \"Big headline in the main image of featured landmarks.\")","                \/\/...","            Text(landmark.name)","                \/\/...","            Button(\"Learn More\") {","                modelData.path.append(landmark)","            }","            \/\/...","        }","        .padding([.bottom], Constants.learnMoreBottomPadding)","    }",""],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"sampleCodeDownload":{"action":{"identifier":"a88428e6793e\/LandmarksBuildingAnAppWithLiquidGlass.zip","isActive":true,"overridingTitle":"Download","type":"reference"},"kind":"sampleDownload"},"schemaV