{"abstract":[{"text":"Arrange views in your app’s interface using layout tools that SwiftUI provides.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Custom-layout"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/composing-custom-layouts-with-swiftui"},"kind":"article","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"modules":[{"name":"SwiftUI"}],"platforms":[{"beta":false,"introducedAt":"16.0","name":"iOS"},{"beta":false,"introducedAt":"16.0","name":"iPadOS"},{"beta":false,"introducedAt":"16.0","name":"Mac Catalyst"},{"beta":false,"introducedAt":"13.0","name":"macOS"},{"beta":false,"introducedAt":"14.0","name":"Xcode"}],"role":"sampleCode","roleHeading":"Sample Code","title":"Composing custom layouts with SwiftUI"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"This sample app demonstrates many of the layout tools that SwiftUI provides by","type":"text"},{"text":" ","type":"text"},{"text":"building an interface that enables people to vote for their favorite kind of","type":"text"},{"text":" ","type":"text"},{"text":"pet. The app offers buttons to vote for a specific pet type, and displays the","type":"text"},{"text":" ","type":"text"},{"text":"vote counts and relative rankings of the various contenders on a leaderboard.","type":"text"},{"text":" ","type":"text"},{"text":"It also shows avatars for the pets, arranged in a way that reflects the current","type":"text"},{"text":" ","type":"text"},{"text":"rankings.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"composing-custom-layouts-with-swiftui-overview.png","type":"image"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"This sample code project is associated with WWDC22 session","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/wwdc22\/10056\/","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"anchor":"Arrange-views-in-two-dimensions-with-a-grid","level":3,"text":"Arrange views in two dimensions with a grid","type":"heading"},{"inlineContent":[{"text":"To draw a leaderboard in the middle of the display that shows vote counts and","type":"text"},{"text":" ","type":"text"},{"text":"percentages, the sample uses a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Grid","isActive":true,"type":"reference"},{"text":" view.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"composing-custom-layouts-with-swiftui-leaderboard.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"The grid contains a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/GridRow","isActive":true,"type":"reference"},{"text":" inside a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ForEach","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"where each view in the row creates a column cell. So the first view appears in","type":"text"},{"text":" ","type":"text"},{"text":"the first column, the second in the second column, and so on. Because the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Divider","isActive":true,"type":"reference"},{"text":" appears outside of a grid row instance, it creates a row","type":"text"},{"text":" ","type":"text"},{"text":"that spans the width of the grid.","type":"text"}],"type":"paragraph"},{"code":["Grid(alignment: .leading) {","    ForEach(model.pets) { pet in","        GridRow {","            Text(pet.type)","            ProgressView(","                value: Double(pet.votes),","                total: Double(max(1, model.totalVotes))) \/\/ Avoid dividing by zero.","            Text(\"\\(pet.votes)\")","                .gridColumnAlignment(.trailing)","        }","","        Divider()","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The sample initializes the grid with leading-edge alignment, which applies to","type":"text"},{"text":" ","type":"text"},{"text":"every cell in the grid. Meanwhile, the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View\/gridColumnAlignment(_:)","isActive":true,"type":"reference"},{"text":" view modifier that appears","type":"text"},{"text":" ","type":"text"},{"text":"on the vote count cell overrides the alignment of cells in that column","type":"text"},{"text":" ","type":"text"},{"text":"to use trailing-edge alignment.","type":"text"}],"type":"paragraph"},{"anchor":"Create-a-custom-equal-width-layout","level":3,"text":"Create a custom equal-width layout","type":"heading"},{"inlineContent":[{"text":"The app offers buttons for voting at the bottom of the interface.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"composing-custom-layouts-with-swiftui-voting-buttons.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"To ensure the buttons all have the same width, but are no wider than the widest","type":"text"},{"text":" ","type":"text"},{"text":"button text, the app creates a custom layout container type that conforms to the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Layout","isActive":true,"type":"reference"},{"text":" protocol. The equal-width horizontal stack","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"MyEqualWidthHStack","type":"codeVoice"},{"text":") measures the ideal sizes of all its subviews, and offers","type":"text"},{"text":" ","type":"text"},{"text":"the widest ideal size to each subview.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The custom stack implements the protocol’s two required methods. First,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","isActive":true,"type":"reference"},{"text":" reports the","type":"text"},{"text":" ","type":"text"},{"text":"container’s size, given a set of subviews.","type":"text"}],"type":"paragraph"},{"code":["func sizeThatFits(","    proposal: ProposedViewSize,","    subviews: Subviews,","    cache: inout Void",") -> CGSize {","    guard !subviews.isEmpty else { return .zero }","","    let maxSize = maxSize(subviews: subviews)","    let spacing = spacing(subviews: subviews)","    let totalSpacing = spacing.reduce(0) { $0 + $1 }","","    return CGSize(","        width: maxSize.width * CGFloat(subviews.count) + totalSpacing,","        height: maxSize.height)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"This method combines the largest size in each dimension with the horizontal","type":"text"},{"text":" ","type":"text"},{"text":"spacing between subviews to find the container’s total size. Then,","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"tells each of the subviews where to appear within the layout’s bounds.","type":"text"}],"type":"paragraph"},{"code":["func placeSubviews(","    in bounds: CGRect,","    proposal: ProposedViewSize,","    subviews: Subviews,","    cache: inout Void",") {","    guard !subviews.isEmpty else { return }","","    let maxSize = maxSize(subviews: subviews)","    let spacing = spacing(subviews: subviews)","","    let placementProposal = ProposedViewSize(width: maxSize.width, height: maxSize.height)","    var nextX = bounds.minX + maxSize.width \/ 2","","    for index in subviews.indices {","        subviews[index].place(","            at: CGPoint(x: nextX, y: bounds.midY),","            anchor: .center,","            proposal: placementProposal)","        nextX += maxSize.width + spacing[index]","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The method creates a single size proposal for the subviews, and then uses","type":"text"},{"text":" ","type":"text"},{"text":"that, along with a point that changes for each subview, to arrange the buttons","type":"text"},{"text":" ","type":"text"},{"text":"in a horizontal line with default spacing.","type":"text"}],"type":"paragraph"},{"anchor":"Choose-the-view-that-fits","level":3,"text":"Choose the view that fits","type":"heading"},{"inlineContent":[{"text":"The size of the voting buttons depends on the width of the text they contain.","type":"text"},{"text":" ","type":"text"},{"text":"For people that speak another language or that use a larger text size,","type":"text"},{"text":" ","type":"text"},{"text":"the horizontally arranged buttons might not fit in the display. So the app uses","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ViewThatFits","isActive":true,"type":"reference"},{"text":" to let SwiftUI choose between a horizontal and","type":"text"},{"text":" ","type":"text"},{"text":"a vertical arrangement of the buttons for the one that fits in the","type":"text"},{"text":" ","type":"text"},{"text":"available space.","type":"text"}],"type":"paragraph"},{"code":["ViewThatFits { \/\/ Choose the first view that fits.","    MyEqualWidthHStack { \/\/ Arrange horizontally if it fits...","        Buttons()","    }","    MyEqualWidthVStack { \/\/ ...or vertically, otherwise.","        Buttons()","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"To ensure that the buttons maintain their equal-width property when arranged","type":"text"},{"text":" ","type":"text"},{"text":"vertically, the app uses a custom equal-width vertical stack","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"MyEqualWidthVStack","type":"codeVoice"},{"text":") that’s very similar to the horizontal version.","type":"text"}],"type":"paragraph"},{"anchor":"Improve-layout-efficiency-with-a-cache","level":3,"text":"Improve layout efficiency with a cache","type":"heading"},{"inlineContent":[{"text":"The methods of the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Layout","isActive":true,"type":"reference"},{"text":" protocol take a bidirectional ","type":"text"},{"code":"cache","type":"codeVoice"},{"text":" ","type":"text"},{"text":"parameter. The cache provides access to optional storage that’s shared among","type":"text"},{"text":" ","type":"text"},{"text":"all the methods of a particular layout instance. To demonstrate the use of a","type":"text"},{"text":" ","type":"text"},{"text":"cache, the sample app’s equal-width vertical layout creates storage to share","type":"text"},{"text":" ","type":"text"},{"text":"size and spacing calculations between its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Layout\/placeSubviews(in:proposal:subviews:cache:)","isActive":true,"type":"reference"},{"text":" implementations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"First, the layout defines a ","type":"text"},{"code":"CacheData","type":"codeVoice"},{"text":" type for the storage.","type":"text"}],"type":"paragraph"},{"code":["struct CacheData {","    let maxSize: CGSize","    let spacing: [CGFloat]","    let totalSpacing: CGFloat","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"It then implements the protocol’s optional ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Layout\/makeCache(subviews:)","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"method to do the calculations for a set of subviews, returning a value of","type":"text"},{"text":" ","type":"text"},{"text":"the type defined above.","type":"text"}],"type":"paragraph"},{"code":["func makeCache(subviews: Subviews) -> CacheData {","    let maxSize = maxSize(subviews: subviews)","    let spacing = spacing(subviews: subviews)","    let totalSpacing = spacing.reduce(0) { $0 + $1 }","","    return CacheData(","        maxSize: maxSize,","        spacing: spacing,","        totalSpacing: totalSpacing)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If the subviews change, SwiftUI calls the layout’s","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Layout\/updateCache(_:subviews:)","isActive":true,"type":"reference"},{"text":" method. The default implementation","type":"text"},{"text":" ","type":"text"},{"text":"of that method calls ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Layout\/makeCache(subviews:)","isActive":true,"type":"reference"},{"text":" again, which","type":"text"},{"text":" ","type":"text"},{"text":"recalculates the data. Then the ","type":"text"},{"code":"sizeThatFits(proposal:subviews:cache:)","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"placeSubviews(in:proposal:subviews:cache:)","type":"codeVoice"},{"text":" methods make","type":"text"},{"text":" ","type":"text"},{"text":"use of their ","type":"text"},{"code":"cache","type":"codeVoice"},{"text":" parameter to retrieve the data. For example,","type":"text"},{"text":" ","type":"text"},{"code":"placeSubviews(in:proposal:subviews:cache:)","type":"codeVoice"},{"text":" reads the size and the spacing","type":"text"},{"text":" ","type":"text"},{"text":"array from the cache.","type":"text"}],"type":"paragraph"},{"code":["let maxSize = cache.maxSize","let spacing = cache.spacing"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Contrast this with the equal-width horizontal stack, which doesn’t use a","type":"text"},{"text":" ","type":"text"},{"text":"cache, and instead calculates the size and spacing information every time","type":"text"},{"text":" ","type":"text"},{"text":"it needs that information.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Most simple layouts, including the equal-width vertical stack, don’t","type":"text"},{"text":" ","type":"text"},{"text":"gain much efficiency from using a cache. Developers can profile their app","type":"text"},{"text":" ","type":"text"},{"text":"with Instruments to find out whether a particular layout type actually","type":"text"},{"text":" ","type":"text"},{"text":"benefits from a cache.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"anchor":"Create-a-custom-radial-layout-with-an-offset","level":3,"text":"Create a custom radial layout with an offset","type":"heading"},{"inlineContent":[{"text":"To display the pet avatars in a circle, the app defines a radial layout","type":"text"},{"text":" ","type":"text"},{"text":"(","type":"text"},{"code":"MyRadialLayout","type":"codeVoice"},{"text":").","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"composing-custom-layouts-with-swiftui-avatars.png","type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"Like other custom layouts, this layout needs the two required methods.","type":"text"},{"text":" ","type":"text"},{"text":"For ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Layout\/sizeThatFits(proposal:subviews:cache:)","isActive":true,"type":"reference"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"the layout fills the available space by returning whatever size its container","type":"text"},{"text":" ","type":"text"},{"text":"proposes.","type":"text"}],"type":"paragraph"},{"code":["proposal.replacingUnspecifiedDimensions()"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The app uses the proposal’s","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ProposedViewSize\/replacingUnspecifiedDimensions(by:)","isActive":true,"type":"reference"},{"text":" method to","type":"text"},{"text":" ","type":"text"},{"text":"convert the proposal into a concrete size. Then, to place subviews, the layout","type":"text"},{"text":" ","type":"text"},{"text":"rotates a vector, translates the vector to the middle of the placement region,","type":"text"},{"text":" ","type":"text"},{"text":"and uses that as the anchor for the subview.","type":"text"}],"type":"paragraph"},{"code":["for (index, subview) in subviews.enumerated() {","    \/\/ Find a vector with an appropriate size and rotation.","    var point = CGPoint(x: 0, y: -radius)","        .applying(CGAffineTransform(","            rotationAngle: angle * Double(index) + offset))","","    \/\/ Shift the vector to the middle of the region.","    point.x += bounds.midX","    point.y += bounds.midY","","    \/\/ Place the subview.","    subview.place(at: point, anchor: .center, proposal: .unspecified)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The offset that the app applies to the rotation accounts for the current","type":"text"},{"text":" ","type":"text"},{"text":"rankings, placing higher-ranked pets closer to the top of the interface. The","type":"text"},{"text":" ","type":"text"},{"text":"app stores ranks on the subviews using the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/LayoutValueKey","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"protocol, and then reads the values to calculate the offset before placing","type":"text"},{"text":" ","type":"text"},{"text":"views.","type":"text"}],"type":"paragraph"},{"anchor":"Animate-transitions-between-layouts","level":3,"text":"Animate transitions between layouts","type":"heading"},{"inlineContent":[{"text":"The radial layout can calculate an offset that creates an appropriate","type":"text"},{"text":" ","type":"text"},{"text":"arrangement for all but one set of rankings: there’s no way to show a three-way","type":"text"},{"text":" ","type":"text"},{"text":"tie with the avatars in a circle. To resolve this, the app detects","type":"text"},{"text":" ","type":"text"},{"text":"this condition, and uses it to put the avatars in a line instead, using a","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/HStackLayout","isActive":true,"type":"reference"},{"text":" type, which is a version of the built-in","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/HStack","isActive":true,"type":"reference"},{"text":" that conforms to the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Layout","isActive":true,"type":"reference"},{"text":" protocol. To","type":"text"},{"text":" ","type":"text"},{"text":"transition between these layout types, the app uses the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/AnyLayout","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"type.","type":"text"}],"type":"paragraph"},{"code":["let layout = model.isAllWayTie ? AnyLayout(HStackLayout()) : AnyLayout(MyRadialLayout())","","Podium()","    .overlay(alignment: .top) {","        layout {","            ForEach(model.pets) { pet in","                Avatar(pet: pet)","                    .rank(model.rank(pet))","            }","        }","        .animation(.default, value: model.pets)","    }"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Because the structural identity of the views remains the same throughout, the","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View\/animation(_:value:)","isActive":true,"type":"reference"},{"text":" view modifier creates animated transitions","type":"text"},{"text":" ","type":"text"},{"text":"between layout types. The modifier also animates radial layout changes","type":"text"},{"text":" ","type":"text"},{"text":"that result from changes in the rankings because the calculated offsets","type":"text"},{"text":" ","type":"text"},{"text":"depend on the same pet data.","type":"text"}],"type":"paragraph"},{"anchor":"Build-documentation-for-the-app","level":3,"text":"Build documentation for the app","type":"heading"},{"inlineContent":[{"text":"To see more information about the symbols defined by this app, you can build","type":"text"},{"text":" ","type":"text"},{"text":"the app’s documentation. Open the project in Xcode and select Product > Build","type":"text"},{"text":" ","type":"text"},{"text":"Documentation.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For information about how to include documentation in your own apps, see","type":"text"},{"text":" ","type":"text"},{"identifier":"https:\/\/www.swift.org\/documentation\/docc","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sampleCodeDownload":{"action":{"identifier":"13cfc7c1502b\/ComposingCustomLayoutsWithSwiftUI.zip","isActive":true,"overridingTitle":"Download","type":"reference"},"kind":"sampleDownload"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Creating-a-custom-layout-container","generated":true,"identifiers":["doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Layout","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/LayoutSubview","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/LayoutSubviews"],"title":"Creating a custom layout container"}],"variants":[{"paths":["\/documentation\/swiftui\/composing-custom-layouts-with-swiftui"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"13cfc7c1502b/ComposingCustomLayoutsWithSwiftUI.zip":{"checksum":null,"identifier":"13cfc7c1502b\/ComposingCustomLayoutsWithSwiftUI.zip","type":"download","url":"13cfc7c1502b\/ComposingCustomLayoutsWithSwiftUI.zip"},"SwiftUI-PageImage-card.png":{"alt":"A stylized Swift logo using dashes on a white or blue background.","identifier":"SwiftUI-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/SwiftUI-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/SwiftUI-PageImage-card~dark@2x.png"}]},"composing-custom-layouts-with-swiftui-avatars.png":{"alt":"Three filled circles placed at equal distances along the outline of a larger, empty circle. The outline of the larger circle uses a dashed line.","identifier":"composing-custom-layouts-with-swiftui-avatars.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/composing-custom-layouts-with-swiftui-avatars@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/composing-custom-layouts-with-swiftui-avatars~dark@2x.png"}]},"composing-custom-layouts-with-swiftui-leaderboard.png":{"alt":"A grid with three rows and three columns. The first column and last column each contain rectangles in every cell. The middle column contains progress indicators with different amounts of progress.","identifier":"composing-custom-layouts-with-swiftui-leaderboard.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/composing-custom-layouts-with-swiftui-leaderboard@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/composing-custom-layouts-with-swiftui-leaderboard~dark@2x.png"}]},"composing-custom-layouts-with-swiftui-overview.png":{"alt":"An iPhone showing the layout of the app, with the three main sections called out. The group of avatars are in a circular arrangement at the top. The leaderboard grid is in the middle. The equal-width voting buttons are at the bottom.","identifier":"composing-custom-layouts-with-swiftui-overview.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/composing-custom-layouts-with-swiftui-overview@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/composing-custom-layouts-with-swiftui-overview~dark@2x.png"}]},"composing-custom-layouts-with-swiftui-voting-buttons.png":{"alt":"Three rectangles arranged in a horizontal line. Each rectangle contains one smaller rectangle. The smaller rectangles have varying widths. Dashed lines above each of the container rectangles show that the larger rectangles all have the same width as each other.","identifier":"composing-custom-layouts-with-swiftui-voting-buttons.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/composing-custom-layouts-with-swiftui-voting-buttons@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/composing-custom-layouts-with-swiftui-voting-buttons~dark@2x.png"}]},"doc://com.apple.SwiftUI/documentation/SwiftUI":{"abstract":[{"text":"Declare the user interface and behavior for your app on every platform.","type":"text"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI","images":[{"identifier":"SwiftUI-PageImage-card.png","type":"card"}],"kind":"symbol","role":"collection","title":"SwiftUI","type":"topic","url":"\/documentation\/swiftui"},"doc://com.apple.SwiftUI/documentation/SwiftUI/AnyLayout":{"abstract":[{"text":"A type-erased instance of the layout protocol.","type":"text"}],"fragments":[{"kind":"keyword","tex