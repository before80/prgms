{"abstract":[{"text":"Provide people with a way to mark their adventures by displaying animated custom activity badges.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Landmarks-Building-an-app-with-Liquid-Glass"],["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View-styles","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Landmarks-Building-an-app-with-Liquid-Glass"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Landmarks-Displaying-custom-activity-badges"},"kind":"article","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"images":[{"identifier":"Landmarks-Building-an-app-with-Liquid-Glass-PageImage-card.png","type":"card"}],"modules":[{"name":"SwiftUI"}],"platforms":[{"beta":false,"introducedAt":"26.0","name":"iOS"},{"beta":false,"introducedAt":"26.0","name":"iPadOS"},{"beta":false,"introducedAt":"26.0","name":"Mac Catalyst"},{"beta":false,"introducedAt":"26.0","name":"macOS"},{"beta":false,"introducedAt":"26.0","name":"Xcode"}],"role":"sampleCode","roleHeading":"Sample Code","title":"Landmarks: Displaying custom activity badges"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"The Landmarks app lets people track their adventures as they explore sites around the world. Whether it’s a national park near their home or a far-flung location on a different continent, the app provides a way for people to mark their adventures and receive custom activity badges along the way.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"identifier":"Landmarks-Building-an-app-with-Liquid-Glass-5","metadata":{"deviceFrame":"iPhone14Pro"},"type":"image"}],"type":"paragraph"},{"inlineContent":[{"text":"This sample displays the badges in a vertical view that includes a toggle button for showing or hiding the badges. The Landmarks app includes a custom modifier that makes it easier for other views to adopt the badge view. By configuring the badges to use Liquid Glass, the badges gain the advantage of using the morphing animation when you show or hide the badges.","type":"text"}],"type":"paragraph"},{"anchor":"Add-a-modifier-to-show-badges-in-other-views","level":2,"text":"Add a modifier to show badges in other views","type":"heading"},{"inlineContent":[{"text":"To make the badges available in other views, like ","type":"text"},{"code":"CollectionsView","type":"codeVoice"},{"text":", the sample uses a custom modifier, ","type":"text"},{"code":"ShowBadgesViewModifier","type":"codeVoice"},{"text":", as a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ViewModifier","isActive":true,"type":"reference"},{"text":". The sample layers the badges over another view using a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/ZStack","isActive":true,"type":"reference"},{"text":", and positions the badge view in the lower trailing corner:","type":"text"}],"type":"paragraph"},{"code":["private struct ShowsBadgesViewModifier: ViewModifier {","    func body(content: Content) -> some View {","        ZStack {","            content","            HStack {","                Spacer()","                VStack {","                    Spacer()","                    BadgesView()","                        .padding()","                }","            }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The sample extends ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View","isActive":true,"type":"reference"},{"text":" by adding the ","type":"text"},{"code":"showBadges","type":"codeVoice"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"code":["extension View {","    func showsBadges() -> some View {","        modifier(ShowsBadgesViewModifier())","    }","}"],"syntax":"swift","type":"codeListing"},{"anchor":"Apply-Liquid-Glass-to-the-toggle-button","level":2,"text":"Apply Liquid Glass to the toggle button","type":"heading"},{"inlineContent":[{"text":"To create the toggle button, the sample configures a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Button","isActive":true,"type":"reference"},{"text":" using ","type":"text"},{"code":"ToggleBadgesLabel","type":"codeVoice"},{"text":" which has different system images for the Show and Hide toggle states. To apply Liquid Glass, style the button with the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/PrimitiveButtonStyle\/glass","isActive":true,"type":"reference"},{"text":" modifier:","type":"text"}],"type":"paragraph"},{"code":["Button {","    \/\/...","} label: {","    \/\/...","}",".buttonStyle(.glass)",""],"syntax":"swift","type":"codeListing"},{"anchor":"Add-Liquid-Glass-to-the-badges","level":2,"text":"Add Liquid Glass to the badges","type":"heading"},{"inlineContent":[{"text":"To add Liquid Glass to each badge, the sample uses the ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View\/glassEffect(_:in:)","isActive":true,"type":"reference"},{"text":" modifier. To make a custom glass view appearance, the sample specifies a rectangular option with a corner radius:","type":"text"}],"type":"paragraph"},{"code":["BadgeLabel(badge: $0)","    .glassEffect(.regular, in: .rect(cornerRadius: Constants.badgeCornerRadius))"],"syntax":"swift","type":"codeListing"},{"anchor":"Animate-the-badges-using-the-morph-effect","level":2,"text":"Animate the badges using the morph effect","type":"heading"},{"inlineContent":[{"text":"The morph effect is an animation for Liquid Glass views. During this animation, the toggle button and each badge start as a combined view. Then, the button and badges change shape like a liquid as they separate and move from one location to another. In reverse, the toggle button and badges change shape and combine back into one view.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To achieve the Liquid Glass morph effect, the app:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"organizes the badges and toggle button into a ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/GlassEffectContainer","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"adds ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View\/glassEffectID(_:in:)","isActive":true,"type":"reference"},{"text":" to each badge","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"adds ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/View\/glassEffectID(_:in:)","isActive":true,"type":"reference"},{"text":" to the toggle button","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"wraps the command that toggles the ","type":"text"},{"code":"isExpanded","type":"codeVoice"},{"text":" property in ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/withAnimation(_:_:)","isActive":true,"type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"},{"code":["\/\/ Organizes the badges and toggle button to animate together.","GlassEffectContainer(spacing: Constants.badgeGlassSpacing) {","    VStack(alignment: .center, spacing: Constants.badgeButtonTopSpacing) {","        if isExpanded {","            VStack(spacing: Constants.badgeSpacing) {","                ForEach(modelData.earnedBadges) {","                    BadgeLabel(badge: $0)","                        \/\/ Adds Liquid Glass to the badge.","                        .glassEffect(.regular, in: .rect(cornerRadius: Constants.badgeCornerRadius))","                        \/\/ Adds an identifier to the badge for animation.","                        .glassEffectID($0.id, in: namespace)","                }","            }","        }","","        Button {","            \/\/ Animates this button and badges when `isExpanded` changes values.","            withAnimation {","                isExpanded.toggle()","            }","        } label: {","            ToggleBadgesLabel(isExpanded: isExpanded)","                .frame(width: Constants.badgeShowHideButtonWidth,","                       height: Constants.badgeShowHideButtonHeight)","        }","        \/\/ Adds Liquid Glass to the button.","        .buttonStyle(.glass)","        #if os(macOS)","        .tint(.clear)","        #endif","        \/\/ Adds an identifier to the button for animation.","        .glassEffectID(\"togglebutton\", in: namespace)","    }","    .frame(width: Constants.badgeFrameWidth)","}"],"syntax":"swift","type":"codeListing"}],"kind":"content"}],"sampleCodeDownload":{"action":{"identifier":"a88428e6793e\/LandmarksBuildingAnAppWithLiquidGlass.zip","isActive":true,"overridingTitle":"Download","type":"reference"},"kind":"sampleDownload"},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"App-features","generated":true,"identifiers":["doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Landmarks-Applying-a-background-extension-effect","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Landmarks-Extending-horizontal-scrolling-under-a-sidebar-or-inspector","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Landmarks-Refining-the-system-provided-glass-effect-in-toolbars"],"title":"App features"}],"variants":[{"paths":["\/documentation\/swiftui\/landmarks-displaying-custom-activity-badges"],"traits":[{"interfaceLanguage":"swift"}]},{"paths":["\/documentation\/swiftui\/landmarks-displaying-custom-activity-badges"],"traits":[{"interfaceLanguage":"occ"}]}],"references":{"Landmarks-Building-an-app-with-Liquid-Glass-5":{"alt":"An image of the landmarks view on an iPhone, with the badges view visible over some landmarks.","identifier":"Landmarks-Building-an-app-with-Liquid-Glass-5","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/Landmarks-Building-an-app-with-Liquid-Glass-5@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/Landmarks-Building-an-app-with-Liquid-Glass-5~dark@2x.png"}]},"Landmarks-Building-an-app-with-Liquid-Glass-PageImage-card.png":{"alt":"An image with a background of Mount Fuji, and in the foreground screenshots of the landmark detail view for Mount Fuji in the Landmarks app, in an iPad and iPhone.","identifier":"Landmarks-Building-an-app-with-Liquid-Glass-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/Landmarks-Building-an-app-with-Liquid-Glass-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/Landmarks-Building-an-app-with-Liquid-Glass-PageImage-card~dark@2x.png"}]},"SwiftUI-PageImage-card.png":{"alt":"A stylized Swift logo using dashes on a white or blue background.","identifier":"SwiftUI-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/SwiftUI-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/SwiftUI-PageImage-card~dark@2x.png"}]},"a88428e6793e/LandmarksBuildingAnAppWithLiquidGlass.zip":{"checksum":null,"identifier":"a88428e6793e\/LandmarksBuildingAnAppWithLiquidGlass.zip","type":"download","url":"a88428e6793e\/LandmarksBuildingAnAppWithLiquidGlass.zip"},"doc://com.apple.SwiftUI/documentation/SwiftUI":{"abstract":[{"text":"Declare the user interface and b