{"abstract":[{"text":"Extend your document-based app to support custom file formats, on-demand file access, and progress reporting.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.apple.documentation\/documentation\/technologies","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Documents"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Handling-advanced-document-scenarios"},"kind":"article","legalNotices":{"copyright":"Copyright &copy; 2026 Apple Inc. All rights reserved.","privacyPolicy":"https:\/\/www.apple.com\/privacy\/privacy-policy","termsOfUse":"https:\/\/www.apple.com\/legal\/internet-services\/terms\/site.html"},"metadata":{"modules":[{"name":"SwiftUI"}],"role":"article","roleHeading":"Article","title":"Handling advanced document scenarios"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"After you’ve created a working document-based app, you can extend it to handle scenarios that go beyond basic reading and writing. Support file formats that the system doesn’t know about by default by using a custom ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype","isActive":true,"type":"reference"},{"text":". Access files outside the normal read and write lifecycle using ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/URLDocumentConfiguration\/makeFileCoordinator()","isActive":true,"type":"reference"},{"text":", for example, to open a specific subfile in a package on demand. Add progress reporting to give people feedback during long operations.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"If you’re new to document-based apps in SwiftUI, start with ","type":"text"},{"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Creating-a-document-based-app","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"anchor":"Declare-a-custom-file-format","level":2,"text":"Declare a custom file format","type":"heading"},{"inlineContent":[{"text":"The system knows about popular built-in formats and their identifiers, like ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype-swift.struct\/utf8plaintext","isActive":true,"type":"reference"},{"text":", ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype-swift.struct\/jpeg","isActive":true,"type":"reference"},{"text":", and ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype-swift.struct\/markdown","isActive":true,"type":"reference"},{"text":". For your own file formats, declare a custom ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype","isActive":true,"overridingTitle":"UTType","overridingTitleInlineContent":[{"code":"UTType","type":"codeVoice"}],"type":"reference"},{"text":" so the Finder, the document browser, and Spotlight understand them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every custom type needs a base type that tells the system what kind of file it is. Use ","type":"text"},{"code":"public.data","type":"codeVoice"},{"text":" or conforming types as a base type for single-file documents, or ","type":"text"},{"code":"com.apple.package","type":"codeVoice"},{"text":" for documents the system stores as a directory but presents as a single file.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Declare the content type in your app target’s information property list under ","type":"text"},{"code":"UTExportedTypeDeclarations","type":"codeVoice"},{"text":" so the Finder, the document browser, and Spotlight all recognize it. Set ","type":"text"},{"code":"UTTypeConformsTo","type":"codeVoice"},{"text":" to the matching base type and add a ","type":"text"},{"code":"UTTypeTagSpecification","type":"codeVoice"},{"text":" that maps the type to your filename extension. The example below declares a notebook package; for a flat-file format, swap ","type":"text"},{"code":"com.apple.package","type":"codeVoice"},{"text":" for ","type":"text"},{"code":"public.data","type":"codeVoice"},{"text":", like this:","type":"text"}],"type":"paragraph"},{"code":["<key>UTExportedTypeDeclarations<\/key>","<array>","    <dict>","        <key>UTTypeIdentifier<\/key>","        <string>com.example.notebook<\/string>","        <key>UTTypeConformsTo<\/key>","        <array>","            <string>com.apple.package<\/string>","        <\/array>","        <key>UTTypeTagSpecification<\/key>","        <dict>","            <key>public.filename-extension<\/key>","            <array>","                <string>examplenotebook<\/string>","            <\/array>","        <\/dict>","    <\/dict>","<\/array>"],"syntax":"xml","type":"codeListing"},{"inlineContent":[{"text":"For convenience, mirror the declaration in code, as shown here:","type":"text"}],"type":"paragraph"},{"code":["extension UTType {","    static let notebook = UTType(exportedAs: \"com.example.notebook\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"Then reference your type from the document’s ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/ReadableDocument\/readableContentTypes","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/WritableDocument\/writableContentTypes","isActive":true,"type":"reference"},{"text":", like this:","type":"text"}],"type":"paragraph"},{"code":["static let readableContentTypes: [UTType] = [.notebook]","static let writableContentTypes: [UTType] = [.notebook, .utf8PlainText]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For more about declaring uniform type identifiers for proprietary formats, see ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/UniformTypeIdentifiers\/defining-file-and-data-types-for-your-app","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Every Mac registers the standard content types that the system provides, but the set of less common types each computer recognizes depends on the software installed on it. A computer might not recognize certain media types, for example, if no installed app declares them. Similarly, a computer that doesn’t have Xcode installed doesn’t recognize ","type":"text"},{"code":"com.apple.xcode.resultbundle","type":"codeVoice"},{"text":", the type identifier for Xcode result bundles.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"},{"anchor":"Access-files-outside-read-and-write","level":2,"text":"Access files outside read and write","type":"heading"},{"inlineContent":[{"text":"SwiftUI coordinates file access for ","type":"text"},{"code":"read","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"write","type":"codeVoice"},{"text":" calls automatically. To access the file URL at other times — for example, when reading a specific subfile in a package — use the configuration’s file coordinator, as shown here:","type":"text"}],"type":"paragraph"},{"code":["let coordinator = document.configuration.makeFileCoordinator()","coordinator.coordinate(","    readingItemAt: packageURL.appending(path: \"metadata.json\"),","                       options: []) { url in","    do {","        let data = try Data(contentsOf: url)","        let metadata = try JSONDecoder().decode(NotebookMetadata.self, from: data)","        \/\/ Process the metadata.","    } catch {","        \/\/ Handle errors.","    }","}"],"syntax":"swift","type":"codeListing"},{"content":[{"inlineContent":[{"text":"Always use ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/URLDocumentConfiguration\/makeFileCoordinator()","isActive":true,"type":"reference"},{"text":" for disk access outside of ","type":"text"},{"code":"read","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"write","type":"codeVoice"},{"text":". Accessing the file URL directly risks corruption because other processes, including iCloud, can change it any time.","type":"text"}],"type":"paragraph"}],"name":"Important","style":"important","type":"aside"},{"anchor":"Report-progress","level":2,"text":"Report progress","type":"heading"},{"inlineContent":[{"text":"Packages let you read and write incrementally; instead of loading or saving the whole document on every change, you can read only the files you need and write only the ones that changed. For notebook documents that consist of multiple files, custom image formats that store data in separate files, or projects with embedded media, this can mean the difference between a fast autosave and a slow one.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Both ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/DocumentReader","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/DocumentWriter","isActive":true,"type":"reference"},{"text":" receive a ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/subprogress","isActive":true,"type":"reference"},{"text":" parameter via their ","type":"text"},{"code":"read","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"write","type":"codeVoice"},{"text":" methods, respectively. Report progress through the parameter so SwiftUI can display the appropriate UI during long operations.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Create a ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/progressreporter","isActive":true,"type":"reference"},{"text":" from the ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/subprogress","isActive":true,"overridingTitle":"Subprogress","overridingTitleInlineContent":[{"code":"Subprogress","type":"codeVoice"}],"type":"reference"},{"text":" by specifying a total unit count. Then call ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/progressreporter\/complete(count:)","isActive":true,"type":"reference"},{"text":" as the work finishes, like this:","type":"text"}],"type":"paragraph"},{"code":["@concurrent ","func read(from source: URL, progress: consuming Subprogress) async throws -> sending ImageSnapshot {","    let progressManager = progress.start(totalCount: 2)","    let data = try Data(contentsOf: source)","    progressManager.complete(count: 1)","    let image = try decodeImage(from: data)","    progressManager.complete(count: 1)","    return ImageSnapshot(image: image)","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"For package documents, you can treat each file as an equal chunk of work, as shown below. This approach gives granular feedback as the writer processes files one by one.","type":"text"}],"type":"paragraph"},{"code":["@concurrent","func write(","    snapshot: sending NotebookSnapshot, to destination: URL,","    previous: sending NotebookSnapshot?, progress: consuming Subprogress",") async throws {","    let changedPages = snapshot.pages.filter { (identifier, content) in","        previous?.pages[identifier] != content","    }","","    \/\/ One unit for metadata, and one unit per changed page.","    let totalUnits = 1 + changedPages.count","    let progressManager = progress.start(totalCount: totalUnits)","","    \/\/ Write the metadata.","    let metadataURL = destination.appending(path: \"metadata.json\")","    let metadataData = try JSONEncoder().encode(snapshot.metadata)","    try metadataData.write(to: metadataURL, options: .atomic)","    progressManager.complete(count: 1)","","    \/\/ Write each changed page individually.","    let fileManager = FileManager.default","    let pagesDirectory = destination.appending(path: \"pages\")","","    \/\/ Create the pages subdirectory if it doesn't already exist.","    try? fileManager.createDirectory(","        at: pagesDirectory, withIntermediateDirectories: true","    )","","    for (identifier, content) in changedPages {","        let pageURL = pagesDirectory.appending(","            path: \"\\(identifier.uuidString).txt\"","        )","        let data = Data(content.utf8)","        try data.write(to: pageURL, options: .atomic)","        progressManager.complete(count: 1)","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"If you use ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/filehandle","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/outputstream","isActive":true,"type":"reference"},{"text":" to write files in chunks — for example, a large media file — report progress after each chunk rather than only once at the end. Each call to ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/progressreporter\/complete(count:)","isActive":true,"overridingTitle":"complete(count:)","overridingTitleInlineContent":[{"code":"complete(count:)","type":"codeVoice"}],"type":"reference"},{"text":" moves the progress bar forward, so spread the calls throughout the write.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The example below writes a large media file to disk in chunks. Set the total unit count to the file size in bytes, and call the reporter after each chunk so the progress bar updates smoothly.","type":"text"}],"type":"paragraph"},{"code":["@concurrent","func write(","    snapshot: sending MediaSnapshot, to destination: URL,","    previous: sending MediaSnapshot?, progress: consuming Subprogress",") async throws {","    let payload = snapshot.payload","    let totalBytes = payload.count","    let progressManager = progress.start(totalCount: totalBytes)","","    try Data().write(to: destination)","    let fileHandle = try FileHandle(forWritingTo: destination)","    defer { try? fileHandle.close() }","","    \/\/ Aim for ~100 progress updates across the write, clamped so chunks","    \/\/ stay large enough to amortize system call overhead and small enough","    \/\/ to keep the progress bar moving on tiny payloads.","    let targetUpdateCount = 100","    let minimumChunkSize = 64 * 1024        \/\/  64 KB","    let maximumChunkSize = 4 * 1024 * 1024  \/\/   4 MB","    let chunkSize = min(","        maximumChunkSize,","        max(minimumChunkSize, totalBytes \/ targetUpdateCount)","    )","","    var offset = 0","    while offset < totalBytes {","        let end = min(offset + chunkSize, totalBytes)","        let chunk = payload[offset..<end]","        try fileHandle.write(contentsOf: chunk)","        progressManager.complete(count: end - offset)","        offset = end","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"The chunk size adapts to the file size, so large files don’t generate unnecessary system overhead. If you stream to an ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/outputstream","isActive":true,"overridingTitle":"OutputStream","overridingTitleInlineContent":[{"code":"OutputStream","type":"codeVoice"}],"type":"reference"},{"text":" instead, the same pattern applies: Open the stream, write chunks of the computed size, call ","type":"text"},{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/progressreporter\/complete(count:)","isActive":true,"overridingTitle":"complete(count:)","overridingTitleInlineContent":[{"code":"complete(count:)","type":"codeVoice"}],"type":"reference"},{"text":" with the bytes written, and call ","type":"text"},{"code":"ProgresManager.complete(count:)","type":"codeVoice"},{"text":" when finished.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Even when you report progress, SwiftUI decides whether to show a progress view.","type":"text"}],"type":"paragraph"}],"name":"Note","style":"note","type":"aside"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"seeAlsoSections":[{"anchor":"Creating-a-document","generated":true,"identifiers":["doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Creating-a-document-based-app","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Updating-your-document-based-app","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Building-a-document-based-app-with-SwiftUI","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Building-a-document-based-app-using-SwiftData","doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DocumentGroup"],"title":"Creating a document"}],"variants":[{"paths":["\/documentation\/swiftui\/handling-advanced-document-scenarios"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"Building-a-document-based-app-PageImage-card.png":{"alt":"A screenshot displaying the document launch experience on iPad with a robot and plant accessory to the left and right of the title view, respectively.","identifier":"Building-a-document-based-app-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/Building-a-document-based-app-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/Building-a-document-based-app-PageImage-card~dark@2x.png"}]},"SwiftUI-PageImage-card.png":{"alt":"A stylized Swift logo using dashes on a white or blue background.","identifier":"SwiftUI-PageImage-card.png","type":"image","variants":[{"traits":["2x","light"],"url":"\/images\/com.apple.SwiftUI\/SwiftUI-PageImage-card@2x.png"},{"traits":["2x","dark"],"url":"\/images\/com.apple.SwiftUI\/SwiftUI-PageImage-card~dark@2x.png"}]},"doc://com.apple.SwiftUI/documentation/SwiftUI":{"abstract":[{"text":"Declare the user interface and behavior for your app on every platform.","type":"text"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI","images":[{"identifier":"SwiftUI-PageImage-card.png","type":"card"}],"kind":"symbol","role":"collection","title":"SwiftUI","type":"topic","url":"\/documentation\/swiftui"},"doc://com.apple.SwiftUI/documentation/SwiftUI/Building-a-document-based-app-using-SwiftData":{"abstract":[{"text":"Code along with the WWDC presenter to transform an app with SwiftData.","type":"text"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Building-a-document-based-app-using-SwiftData","kind":"article","role":"sampleCode","title":"Building a document-based app using SwiftData","type":"topic","url":"\/documentation\/swiftui\/building-a-document-based-app-using-swiftdata"},"doc://com.apple.SwiftUI/documentation/SwiftUI/Building-a-document-based-app-with-SwiftUI":{"abstract":[{"text":"Create, save, and open documents in a multiplatform app.","type":"text"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Building-a-document-based-app-with-SwiftUI","images":[{"identifier":"Building-a-document-based-app-PageImage-card.png","type":"card"}],"kind":"article","role":"sampleCode","title":"Building a document-based app with SwiftUI","type":"topic","url":"\/documentation\/swiftui\/building-a-document-based-app-with-swiftui"},"doc://com.apple.SwiftUI/documentation/SwiftUI/Creating-a-document-based-app":{"abstract":[{"text":"Build apps that people can use to open, edit, and save files using coordinated file access.","type":"text"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Creating-a-document-based-app","kind":"article","role":"article","title":"Creating a document-based app","type":"topic","url":"\/documentation\/swiftui\/creating-a-document-based-app"},"doc://com.apple.SwiftUI/documentation/SwiftUI/DocumentGroup":{"abstract":[{"text":"A scene that enables support for opening, creating, and saving documents.","type":"text"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"DocumentGroup"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/DocumentGroup","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DocumentGroup"}],"role":"symbol","title":"DocumentGroup","type":"topic","url":"\/documentation\/swiftui\/documentgroup"},"doc://com.apple.SwiftUI/documentation/SwiftUI/Documents":{"abstract":[{"text":"Enable people to open and manage documents.","type":"text"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Documents","kind":"article","role":"collectionGroup","title":"Documents","type":"topic","url":"\/documentation\/swiftui\/documents"},"doc://com.apple.SwiftUI/documentation/SwiftUI/Updating-your-document-based-app":{"abstract":[{"text":"Migrate an existing app to adopt URL-based document reading and writing with Swift concurrency.","type":"text"}],"identifier":"doc:\/\/com.apple.SwiftUI\/documentation\/SwiftUI\/Updating-your-document-based-app","kind":"article","role":"article","title":"Updating your document-based app","type":"topic","url":"\/documentation\/swiftui\/updating-your-document-based-app"},"doc://com.apple.documentation/documentation/SwiftUI/DocumentReader":{"abstract":[{"text":"A type that reads a document’s content from a file.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DocumentReader"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/DocumentReader","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DocumentReader"}],"role":"symbol","title":"DocumentReader","type":"topic","url":"\/documentation\/swiftui\/documentreader"},"doc://com.apple.documentation/documentation/SwiftUI/DocumentWriter":{"abstract":[{"text":"A type that writes a document’s content to a file.","type":"text"}],"fragments":[{"kind":"keyword","text":"protocol"},{"kind":"text","text":" "},{"kind":"identifier","text":"DocumentWriter"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/DocumentWriter","kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"DocumentWriter"}],"role":"symbol","title":"DocumentWriter","type":"topic","url":"\/documentation\/swiftui\/documentwriter"},"doc://com.apple.documentation/documentation/SwiftUI/ReadableDocument/readableContentTypes":{"abstract":[{"text":"The content types this document can open.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"readableContentTypes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:22UniformTypeIdentifiers6UTTypeV","text":"UTType"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/ReadableDocument\/readableContentTypes","kind":"symbol","role":"symbol","title":"readableContentTypes","type":"topic","url":"\/documentation\/swiftui\/readabledocument\/readablecontenttypes"},"doc://com.apple.documentation/documentation/SwiftUI/URLDocumentConfiguration/makeFileCoordinator()":{"abstract":[{"text":"Creates a file coordinator for coordinated disk access","type":"text"},{"text":" ","type":"text"},{"text":"outside the normal read\/write flow.","type":"text"}],"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"makeFileCoordinator"},{"kind":"text","text":"() -> sending "},{"kind":"typeIdentifier","preciseIdentifier":"c:objc(cs)NSFileCoordinator","text":"NSFileCoordinator"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/URLDocumentConfiguration\/makeFileCoordinator()","kind":"symbol","role":"symbol","title":"makeFileCoordinator()","type":"topic","url":"\/documentation\/swiftui\/urldocumentconfiguration\/makefilecoordinator()"},"doc://com.apple.documentation/documentation/SwiftUI/WritableDocument/writableContentTypes":{"abstract":[{"text":"The content types this document can save or export to.","type":"text"}],"fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"writableContentTypes"},{"kind":"text","text":": ["},{"kind":"typeIdentifier","preciseIdentifier":"s:22UniformTypeIdentifiers6UTTypeV","text":"UTType"},{"kind":"text","text":"]"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/SwiftUI\/WritableDocument\/writableContentTypes","kind":"symbol","role":"symbol","title":"writableContentTypes","type":"topic","url":"\/documentation\/swiftui\/writabledocument\/writablecontenttypes"},"doc://com.apple.documentation/documentation/UniformTypeIdentifiers/defining-file-and-data-types-for-your-app":{"abstract":[{"text":"Declare uniform type identifiers to support your app’s proprietary data formats.","type":"text"}],"identifier":"doc:\/\/com.apple.documentation\/documentation\/UniformTypeIdentifiers\/defining-file-and-data-types-for-your-app","kind":"article","role":"article","title":"Defining file and data types for your app","type":"topic","url":"\/documentation\/uniformtypeidentifiers\/defining-file-and-data-types-for-your-app"},"doc://com.apple.documentation/documentation/technologies":{"abstract":[],"identifier":"doc:\/\/com.apple.documentation\/documentation\/technologies","kind":"technologies","role":"overview","title":"Technologies","type":"topic","url":"\/documentation\/technologies"},"https://developer.apple.com/documentation/foundation/filehandle":{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/filehandle","title":"FileHandle","titleInlineContent":[{"code":"FileHandle","type":"codeVoice"}],"type":"link","url":"https:\/\/developer.apple.com\/documentation\/foundation\/filehandle"},"https://developer.apple.com/documentation/foundation/outputstream":{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/outputstream","title":"OutputStream","titleInlineContent":[{"code":"OutputStream","type":"codeVoice"}],"type":"link","url":"https:\/\/developer.apple.com\/documentation\/foundation\/outputstream"},"https://developer.apple.com/documentation/foundation/progressreporter":{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/progressreporter","title":"ProgressReporter","titleInlineContent":[{"code":"ProgressReporter","type":"codeVoice"}],"type":"link","url":"https:\/\/developer.apple.com\/documentation\/foundation\/progressreporter"},"https://developer.apple.com/documentation/foundation/progressreporter/complete(count:)":{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/progressreporter\/complete(count:)","title":"complete(count:)","titleInlineContent":[{"code":"complete(count:)","type":"codeVoice"}],"type":"link","url":"https:\/\/developer.apple.com\/documentation\/foundation\/progressreporter\/complete(count:)"},"https://developer.apple.com/documentation/foundation/subprogress":{"identifier":"https:\/\/developer.apple.com\/documentation\/foundation\/subprogress","title":"Subprogress","titleInlineContent":[{"code":"Subprogress","type":"codeVoice"}],"type":"link","url":"https:\/\/developer.apple.com\/documentation\/foundation\/subprogress"},"https://developer.apple.com/documentation/uniformtypeidentifiers/uttype":{"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype","title":"UTType","titleInlineContent":[{"code":"UTType","type":"codeVoice"}],"type":"link","url":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype"},"https://developer.apple.com/documentation/uniformtypeidentifiers/uttype-swift.struct/jpeg":{"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype-swift.struct\/jpeg","title":"jpeg","titleInlineContent":[{"code":"jpeg","type":"codeVoice"}],"type":"link","url":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype-swift.struct\/jpeg"},"https://developer.apple.com/documentation/uniformtypeidentifiers/uttype-swift.struct/markdown":{"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype-swift.struct\/markdown","title":"markdown","titleInlineContent":[{"code":"markdown","type":"codeVoice"}],"type":"link","url":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype-swift.struct\/markdown"},"https://developer.apple.com/documentation/uniformtypeidentifiers/uttype-swift.struct/utf8plaintext":{"identifier":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype-swift.struct\/utf8plaintext","title":"utf8PlainText","titleInlineContent":[{"code":"utf8PlainText","type":"codeVoice"}],"type":"link","url":"https:\/\/developer.apple.com\/documentation\/uniformtypeidentifiers\/uttype-swift.struct\/utf8plaintext"}}}