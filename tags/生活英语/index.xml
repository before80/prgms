 &lt;td&gt;定制饮品、外带、叫号、快餐点单&lt;/td&gt;
 &lt;td&gt;★&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;6&lt;/td&gt;
 &lt;td&gt;&lt;a href="shopping/"&gt;购物&lt;/a&gt;&lt;/td&gt;
 &lt;td&gt;找尺码、试穿、退换、问折扣&lt;/td&gt;
 &lt;td&gt;★★&lt;/td&gt;
 &lt;/tr&gt;
