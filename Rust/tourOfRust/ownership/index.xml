&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#aa89ea"&gt;bar&lt;/span&gt;: &lt;span style="color:#ca72ff"&gt;Bar&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;,&lt;/span&gt;
