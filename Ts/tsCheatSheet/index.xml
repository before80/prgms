&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"&gt; 9
&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"&gt;10
&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"&gt;11
&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"&gt;12
&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"&gt;13
&lt;/span&gt;&lt;span style="white-space:pre;-webkit-user-select:none;user-select:none;margin-right:0.4em;padding:0 0.4em 0 0.4em;color:#58626f"&gt;14
&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;
&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%"&gt;
&lt;pre tabindex="0" style="color:#b0c4de;background-color:#282c34;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-jsonc" data-lang="jsonc"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#abb2bf"&gt;{&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#76a9f9"&gt;&amp;#34;name&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;:&lt;/span&gt; &lt;span style="color:#63c381"&gt;&amp;#34;mylib&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;,&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#76a9f9"&gt;&amp;#34;version&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;:&lt;/span&gt; &lt;span style="color:#63c381"&gt;&amp;#34;1.0.0&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;,&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#76a9f9"&gt;&amp;#34;type&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;:&lt;/span&gt; &lt;span style="color:#63c381"&gt;&amp;#34;module&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;,&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#76a9f9"&gt;&amp;#34;main&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;:&lt;/span&gt; &lt;span style="color:#63c381"&gt;&amp;#34;./dist/index.js&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;,&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#76a9f9"&gt;&amp;#34;types&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;:&lt;/span&gt; &lt;span style="color:#63c381"&gt;&amp;#34;./dist/index.d.ts&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;,&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#76a9f9"&gt;&amp;#34;exports&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;:&lt;/span&gt; &lt;span style="color:#abb2bf"&gt;{&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#76a9f9"&gt;&amp;#34;.&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;:&lt;/span&gt; &lt;span style="color:#abb2bf"&gt;{&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#76a9f9"&gt;&amp;#34;types&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;:&lt;/span&gt; &lt;span style="color:#63c381"&gt;&amp;#34;./dist/index.d.ts&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;,&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#76a9f9"&gt;&amp;#34;default&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;:&lt;/span&gt; &lt;span style="color:#63c381"&gt;&amp;#34;./dist/index.js&amp;#34;&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#abb2bf"&gt;}&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#abb2bf"&gt;},&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#76a9f9"&gt;&amp;#34;files&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;:&lt;/span&gt; &lt;span style="color:#abb2bf"&gt;[&lt;/span&gt;&lt;span style="color:#63c381"&gt;&amp;#34;dist&amp;#34;&lt;/span&gt;&lt;span style="color:#abb2bf"&gt;]&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#abb2bf"&gt;}&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;
&lt;/div&gt;
&lt;/div&gt;&lt;table&gt;
 &lt;thead&gt;
 &lt;tr&gt;
 &lt;th&gt;字段&lt;/th&gt;
 &lt;th&gt;作用&lt;/th&gt;
 &lt;th&gt;还需要吗&lt;/th&gt;
 &lt;/tr&gt;
 &lt;/thead&gt;
 &lt;tbody&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;types&lt;/code&gt;（顶层）&lt;/td&gt;
 &lt;td&gt;老工具的类型入口&lt;/td&gt;
 &lt;td&gt;✅ 保留，兼容旧 &lt;code&gt;node10&lt;/code&gt; 解析&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;main&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;老工具的 JS 入口&lt;/td&gt;
 &lt;td&gt;✅ 保留，兼容 CJS&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;exports&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;&lt;strong&gt;现代解析的唯一事实来源&lt;/strong&gt;&lt;/td&gt;
 &lt;td&gt;✅ 必须有 🔥&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;files&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;控制发布哪些文件&lt;/td&gt;
 &lt;td&gt;✅ 别忘了 &lt;code&gt;dist&lt;/code&gt;&lt;/td&gt;
 &lt;/tr&gt;
 &lt;tr&gt;
 &lt;td&gt;&lt;code&gt;type&lt;/code&gt;&lt;/td&gt;
 &lt;td&gt;决定 &lt;code&gt;.js&lt;/code&gt; 被当作 ESM 还是 CJS&lt;/td&gt;
 &lt;td&gt;✅ 明确写&lt;/td&gt;
 &lt;/tr&gt;
 &lt;/tbody&gt;
&lt;/table&gt;
&lt;blockquote&gt;
&lt;p&gt;⚠️ &lt;strong&gt;&lt;code&gt;files&lt;/code&gt; 忘了写 &lt;code&gt;dist&lt;/code&gt;&lt;/strong&gt; 会导致发布了&lt;strong&gt;没有产物&lt;/strong&gt;的包——本地测试正常，装到别的项目就报 &lt;code&gt;Cannot find module&lt;/code&gt;。这是最常见的发布事故。&lt;/p&gt;</description></item><item><title>14 JSX 与前端类型模式</title><link>https://before80.github.io/prgms/Ts/tsCheatSheet/14-JSX-and-Frontend-Type-Patterns/</link><pubDate>Fri, 27 Mar 2026 10:00:00 +0800</pubDate><guid>https://before80.github.io/prgms/Ts/tsCheatSheet/14-JSX-and-Frontend-Type-Patterns/</guid><description>&lt;h1 id="14-jsx-与前端类型模式"&gt;14 JSX 与前端类型模式&lt;/h1&gt;
&lt;p&gt;本页只讲&lt;strong&gt;类型层面的模式&lt;/strong&gt;——组件签名、事件类型、Hook 推断。框架用法请查框架文档。&lt;/p&gt;
&lt;blockquote&gt;
&lt;p&gt;⚠️ 涉及 React 的具体 API 时，本页基于 React 19 的 &lt;code&gt;@types/react&lt;/code&gt;。&lt;strong&gt;类型包版本不同，细节可能有差异&lt;/strong&gt;，请以你项目里实际安装的 &lt;code&gt;.d.ts&lt;/code&gt; 为准。&lt;/p&gt;</description></item><item><title>15 从 JS 迁移与生态互操作</title><link>https://before80.github.io/prgms/Ts/tsCheatSheet/15-Migrating-JS-to-TS-and-Ecosystem-Interop/</link><pubDate>Fri, 27 Mar 2026 10:00:00 +0800</pubDate><guid>https://before80.github.io/prgms/Ts/tsCheatSheet/15-Migrating-JS-to-TS-and-Ecosystem-Interop/</guid><description>&lt;h1 id="15-从-js-迁移与生态互操作"&gt;15 从 JS 迁移与生态互操作&lt;/h1&gt;
&lt;p&gt;把老 JS 项目搬上 TypeScript，难点不在语法，而在&lt;strong&gt;如何在不停工的前提下逐步收紧&lt;/strong&gt;。&lt;/p&gt;
&lt;blockquote&gt;
&lt;p&gt;⚠️ &lt;strong&gt;6.0 让迁移变难了一点&lt;/strong&gt;：&lt;code&gt;strict&lt;/code&gt; 默认变为 &lt;code&gt;true&lt;/code&gt;、&lt;code&gt;types&lt;/code&gt; 默认变为 &lt;code&gt;[]&lt;/code&gt;。所以从 5.x 升级或从零引入时，&lt;strong&gt;第一步应该是显式固定这两个选项&lt;/strong&gt;，而不是直接吃默认值。详见 &lt;a href="https://before80.github.io/prgms/Ts/tsCheatSheet/08-tsconfig-Reference/"&gt;08 tsconfig&lt;/a&gt;。&lt;/p&gt;</description></item><item><title>16 血泪速查</title><link>https://before80.github.io/prgms/Ts/tsCheatSheet/16-Pitfalls-and-Gotchas/</link><pubDate>Fri, 27 Mar 2026 10:00:00 +0800</pubDate><guid>https://before80.github.io/prgms/Ts/tsCheatSheet/16-Pitfalls-and-Gotchas/</guid><description>&lt;h1 id="16-血泪速查"&gt;16 血泪速查&lt;/h1&gt;
&lt;p&gt;这一页&lt;strong&gt;按症状索引&lt;/strong&gt;，不是按语法索引。出问题时从「我看到的现象」出发查，比从「这是哪个语法」出发快得多。&lt;/p&gt;
&lt;blockquote&gt;
&lt;p&gt;本页所有「实际发生什么」都在 TS 6.0.3 实测过。&lt;/p&gt;</description></item><item><title>17 编译器与性能</title><link>https://before80.github.io/prgms/Ts/tsCheatSheet/17-Compiler-Internals-and-Performance/</link><pubDate>Fri, 27 Mar 2026 10:00:00 +0800</pubDate><guid>https://before80.github.io/prgms/Ts/tsCheatSheet/17-Compiler-Internals-and-Performance/</guid><description>&lt;h1 id="17-编译器与性能"&gt;17 编译器与性能&lt;/h1&gt;
&lt;p&gt;「&lt;code&gt;tsc&lt;/code&gt; 好慢」是可以&lt;strong&gt;量化定位&lt;/strong&gt;的，不用猜。本页讲清楚每个诊断指标的含义和对应的解法。&lt;/p&gt;
&lt;blockquote&gt;
&lt;p&gt;本页所有命令输出格式均在 TS 6.0.3 实测。&lt;/p&gt;
&lt;/blockquote&gt;
&lt;hr&gt;
&lt;h2 id="编译流水线"&gt;编译流水线&lt;/h2&gt;
&lt;p&gt;理解阶段划分，才能把「慢」定位到具体环节。&lt;/p&gt;</description></item></channel></rss>